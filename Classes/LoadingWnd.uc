class LoadingWnd extends UIScript;

var TextureHandle zzbacktext;
var TextureHandle zzreviewtex;
var string zzskinloading;
var string zzrandomskina;
 
function OnLoad()
{
	RegisterEvent(170);
	RegisterEvent(2900);
	zzbacktext = TextureHandle(GetHandle("LoadingWnd.BlackBackTex"));
	zzreviewtex = TextureHandle(GetHandle("LoadingWnd.ReviewTex"));
	lodtexa();
	return;
}
 
function OnShow()
{
	zzrandomskina = string(Rand(12));
	zzskinloading = "L2UI_CH3.skins.loading_"$zzrandomskina;
	zzreviewtex.SetTexture(zzskinloading);
	return;
}
 
function OnEvent(int zzid, string zzparam)
{
	local int zzconceoa2;
 
     // End:0x43
	if( zzid == 170 )
	{
         // End:0x43
		if( ParseInt(zzparam, "ServerAgeLimit", zzconceoa2) )
		{
			zzreviewtex.SetTexture(zzskinloading);
		}
	}
     // End:0x58
	if( zzid == 2900 )
	{
		lodtexa();
	}
	return;
}
 
function lodtexa()
{
	local int zzi, zzu;
 
	GetCurrentResolution(zzi, zzu);
	zzbacktext.SetWindowSize(zzi, zzu);
	zzreviewtex.SetWindowSize(zzi, zzu);
	zzreviewtex.SetAnchor("LoadingWnd", "CenterCenter", "CenterCenter", 0, 0);
	zzreviewtex.SetWindowSizeRel43(1, 1, 0, 0);
	return;
}
