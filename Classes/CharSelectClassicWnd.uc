class CharSelectClassicWnd extends UICommonAPI;

function OnShow()
{
	local L2Util zzutilbar;
	local string zztext;
	zzutilbar = L2Util(GetScript("L2Util"));

	HideWindow("MessageWnd");
	Class'UIAPI_WINDOW'.static.ShowWindow("CharSelectClassicWnd.VK_TEXT");
	
	GetINIString("PatchSettings", "BOTTOM_TEXT", zztext, "PatchSettings");
	Class'UIAPI_TEXTBOX'.static.SetText("CharSelectClassicWnd.VK_TEXT", zztext);
	Class'UIAPI_TEXTBOX'.static.SetTextColor("CharSelectClassicWnd.VK_TEXT", xxGetColorito("White"));
	return;
}
