 class SideBarWnd extends UICommonAPI;

 var WindowHandle Me;
 var ButtonHandle zzbtnmin;
 var ButtonHandle zzbtnDonate;
 var ButtonHandle zzbtnRaidInfo;
 var ButtonHandle zzbtnRanking;
 var ButtonHandle zzbtnEvent;
 var ButtonHandle btnFarm;
 var bool zzisanswer;
 var string tooltip1;
 var string tooltip2;
 var string tooltip3;
 var string tooltip4;
 var string tooltip5;
 
 function OnLoad()
 {
	 RegisterEvent(2900);
	 RegisterEvent(98716);
	 Me = GetHandle("SideBarWnd");
	 
	 
	 GetINIString("PatchSettings", "TOOL_TIP1", tooltip1, "PatchSettings");
	 GetINIString("PatchSettings", "TOOL_TIP2", tooltip2, "PatchSettings");
	 GetINIString("PatchSettings", "TOOL_TIP3", tooltip3, "PatchSettings");
	 GetINIString("PatchSettings", "TOOL_TIP4", tooltip4, "PatchSettings");
	 GetINIString("PatchSettings", "TOOL_TIP5", tooltip5, "PatchSettings");
	 
	 
	 zzbtnmin = ButtonHandle(GetHandle("SideBarWnd.btnMin"));
	 zzbtnmin.SetTooltipCustomType(xxsettooltip("Minimizar"));
	 zzbtnDonate = ButtonHandle(GetHandle("SideBarWnd.btnDonate"));
 //	zzbtnDonate.SetTooltipCustomType(xxsettooltip("Votacion"));
 //	zzbtnDonate.SetTooltipCustomType(xxsettooltip("Market Place"));
	 zzbtnDonate.SetTooltipCustomType(xxsettooltip(tooltip1));
 //	zzbtnDonate.SetTooltipCustomType(xxsettooltip("Community"));
	 zzbtnRaidInfo = ButtonHandle(GetHandle("SideBarWnd.btnRaidInfo"));
	 //zzbtnRaidInfo.SetTooltipCustomType(xxsettooltip("Menu"));
 //	zzbtnRaidInfo.SetTooltipCustomType(xxsettooltip("Comunidad"));
   
	 
	 zzbtnRaidInfo.SetTooltipCustomType(xxsettooltip(tooltip2));	
	 zzbtnRanking = ButtonHandle(GetHandle("SideBarWnd.btnRanking"));
	 zzbtnRanking.SetTooltipCustomType(xxsettooltip(tooltip3));
 //	zzbtnRanking.SetTooltipCustomType(xxsettooltip("Skins"));
 //	zzbtnRanking.SetTooltipCustomType(xxsettooltip("Ranking"));	
	 zzbtnEvent = ButtonHandle(GetHandle("SideBarWnd.btnEvent"));
 //	zzbtnEvent.SetTooltipCustomType(xxsettooltip("Roullete"));
 //	zzbtnEvent.SetTooltipCustomType(xxsettooltip("Menu"));
	 zzbtnEvent.SetTooltipCustomType(xxsettooltip(tooltip4));
	 btnFarm = ButtonHandle(GetHandle("SideBarWnd.btnFarm2a"));
	 btnFarm.SetTooltipCustomType(xxsettooltip(tooltip5));
	 HideWindow("SideBarWnd.ExpandBG1");
	 return;
 }
 
 function OnEvent(int i, string param)
 {
	 switch(i)
	 {
		 // End:0x18
		 case 2900:
			 OnDefaultPosition();
			 // End:0x1B
			 break;
		 // End:0xFFFF
		 default:
			 break;
	 }
	 return;
 }
 
 function OnDefaultPosition()
 {
	 Me.SetAnchor("", "CenterRight", "CenterRight", 0, 0);
	 return;
 }
 
 
 
 
 function ExecuteOpenCbBypass()
 {
	 local string strParam;
	 ParamAdd(strParam, "Init", "1");
	 ExecuteEvent(EV_ShowBBS, strParam);
 }
 
 function ExecuteSpecialCraftBypass()
 {
	 local string strBypass;
	 // strBypass = "_specialcraftinterface"; // Bypass to execute
	 RequestBypassToServer(strBypass);
 
 
 }
 
 function ExecuteInstanceBypass()
 {
	 local string strBypass;
	 strBypass = "_instancesinterface"; // Bypass to execute
	 RequestBypassToServer(strBypass);
 
 
 }
 
 function ExecuteHuntpassBypass()
 {
	 local string strBypass;
	 strBypass = "_huntpassinterface"; // Bypass to execute
	 RequestBypassToServer(strBypass);
 
 
 }
 
 
 
 function LotusCOmmand(string val)
 {
 
	 ExecuteCommand(val);
 }
 
 
 function OnClickButton(string param)
 {

	 
	 switch(param)
	 {
		 // End:0x27
		 case "btnDonate":
		 ExecuteCommand(".donate");		
		 break;
		 // End:0x4B
		 case "btnRaidInfo":
		 RequestBypassToServer("bp_showMarketPlace");	
			 break;
		 // End:0x6D
		 case "btnRanking":
		 ExecuteCommand(".bstatus");
		 break;
 
		 case "btnEvent":
		 ExecuteCommand(".menu");
			 break;
			 case "Letters":
		RequestBypassToServer("bp_openhtml mods/lucky/40079.htm");
			 break;
		 // End:0xA0
		 case "btnMin":
			 xxminexpand();
			 // End:0xB8
			 break;
		 // End:0xB5
	 case "btnFarm2a":
		 if( IsShowWindow("AutoHunting") )
			 {
				 HideWindow("AutoHunting");
				 PlaySound("InterfaceSound.system_close_01");
						   
			 }
			 else
			 {
				 ShowWindowWithFocus("AutoHunting");
				 PlaySound("InterfaceSound.system_open_01");
				 
			 }
			  // End:0x395
			 break;
		 // End:0xFFFF
		 default:
			 break;
	 }
	 return;
 }
 
 function xxhideshowautofarm()
 {
	 // End:0x5C
	 if( IsShowWindow("AutoHunting") )
	 {
		 HideWindow("AutoHunting");
		 btnFarm.SetTooltipCustomType(xxsettooltip("Show Auto Hunting"));
		 zzisanswer = False;        
	 }
	 else
	 {
		 ShowWindowWithFocus("AutoHunting");
		 btnFarm.SetTooltipCustomType(xxsettooltip("Hide Auto Hunting"));
		 zzisanswer = True;
	 }
	 SetOptionBool("lotus_custom", "AutoPlay", zzisanswer);
	 return;
 }
 
 function xxminexpand()
 {
	 // End:0x11A
	 if( IsShowWindow("SideBarWnd.SideBarButtons") )
	 {
		 xxGetButtonHandle("SideBarWnd.btnMin").SetTexture("L2UI_CH3.SideBarWnd.SidebarExpandBtn_N", "L2UI_CH3.SideBarWnd.SidebarExpandBtn_D", "L2UI_CH3.SideBarWnd.SidebarExpandBtn_O");
		 HideWindow("SideBarWnd.SideBarButtons");
		 HideWindow("SideBarWnd.ExpandBG");
		 ShowWindow("SideBarWnd.ExpandBG1"); 
		 zzbtnmin.SetTooltipCustomType(xxsettooltip("Expandir"));		
	 }
	 else
	 {
		 xxGetButtonHandle("SideBarWnd.btnMin").SetTexture("L2UI_CH3.SideBarWnd.SideBarWnd_MinBtn", "L2UI_CH3.SideBarWnd.SideBarWnd_MinBtn_down", "L2UI_CH3.SideBarWnd.SideBarWnd_MinBtn_over");
		 ShowWindow("SideBarWnd.SideBarButtons");
		 ShowWindow("SideBarWnd.ExpandBG");
		 HideWindow("SideBarWnd.ExpandBG1");
		 zzbtnmin.SetTooltipCustomType(xxsettooltip("Minimizar"));
	 }
	 return;
 }
 
 function CustomTooltip xxsettooltip(string zzparam)
 {
	 local CustomTooltip zzToolTip;
	 local DrawItemInfo zzinflot;
 
	 zzToolTip.DrawList.Length = 1;
	 zzinflot.eType = DIT_TEXT;
	 zzinflot.t_strText = zzparam;
	 zzToolTip.DrawList[0] = zzinflot;
	 return zzToolTip;
 
 }
defaultproperties
{
}
