function HandleShowChatWindow()
{
    local WindowHandle zzchatas;

    zzchatas = GetHandle("ChatWnd");
    // End:0xB9
    if(zzchatas.IsShowWindow())
    {
        zzchatas.HideWindow();
        xxGetWindowHandle("ChatHideWnd").ShowWindow();
        PlaySound("InterfaceSound.inventory_close_01");
        // End:0xB6
        if(GetOptionBool("Game", "SystemMsgWnd"))
        {
            Class'UIAPI_WINDOW'.static.HideWindow("SystemMsgWnd");
        }        
    }
    else
    {
        zzchatas.ShowWindow();
        xxGetWindowHandle("ChatHideWnd").HideWindow();
        PlaySound("InterfaceSound.inventory_open_01");
        // End:0x147
        if(GetOptionBool("Game", "SystemMsgWnd"))
        {
            Class'UIAPI_WINDOW'.static.ShowWindow("SystemMsgWnd");
        }
    }
    return;
}

function HandleSetPrevChatType()
{
    local ChatWnd zzcasaa;

    zzcasaa = ChatWnd(GetScript("ChatWnd"));
    switch(zzcasaa.m_chatType)
    {
        // End:0xD0
        case 0:
            zzcasaa.ChatTabCtrl.MergeTab(1);
            zzcasaa.ChatTabCtrl.MergeTab(2);
            zzcasaa.ChatTabCtrl.MergeTab(3);
            zzcasaa.ChatTabCtrl.MergeTab(4);
            zzcasaa.ChatTabCtrl.SetTopOrder(4, true);
            zzcasaa.HandleTabClick("ChatTabCtrl4");
            // End:0x369
            break;
        // End:0x175
        case 1:
            zzcasaa.ChatTabCtrl.MergeTab(0);
            zzcasaa.ChatTabCtrl.MergeTab(2);
            zzcasaa.ChatTabCtrl.MergeTab(3);
            zzcasaa.ChatTabCtrl.MergeTab(4);
            zzcasaa.ChatTabCtrl.SetTopOrder(0, true);
            zzcasaa.HandleTabClick("ChatTabCtrl0");
            // End:0x369
            break;
        // End:0x21A
        case 2:
            zzcasaa.ChatTabCtrl.MergeTab(0);
            zzcasaa.ChatTabCtrl.MergeTab(1);
            zzcasaa.ChatTabCtrl.MergeTab(3);
            zzcasaa.ChatTabCtrl.MergeTab(4);
            zzcasaa.ChatTabCtrl.SetTopOrder(1, true);
            zzcasaa.HandleTabClick("ChatTabCtrl1");
            // End:0x369
            break;
        // End:0x2C0
        case 3:
            zzcasaa.ChatTabCtrl.MergeTab(0);
            zzcasaa.ChatTabCtrl.MergeTab(1);
            zzcasaa.ChatTabCtrl.MergeTab(2);
            zzcasaa.ChatTabCtrl.MergeTab(3);
            zzcasaa.ChatTabCtrl.SetTopOrder(2, true);
            zzcasaa.HandleTabClick("ChatTabCtrl2");
            // End:0x369
            break;
        // End:0x366
        case 4:
            zzcasaa.ChatTabCtrl.MergeTab(0);
            zzcasaa.ChatTabCtrl.MergeTab(1);
            zzcasaa.ChatTabCtrl.MergeTab(2);
            zzcasaa.ChatTabCtrl.MergeTab(3);
            zzcasaa.ChatTabCtrl.SetTopOrder(3, true);
            zzcasaa.HandleTabClick("ChatTabCtrl3");
            // End:0x369
            break;
        // End:0xFFFF
        default:
            break;
    }
    return;
}

function HandleSetNextChatType()
{
    local ChatWnd zzcasaa;

    zzcasaa = ChatWnd(GetScript("ChatWnd"));
    switch(zzcasaa.m_chatType)
    {
        // End:0xCF
        case 0:
            zzcasaa.ChatTabCtrl.MergeTab(0);
            zzcasaa.ChatTabCtrl.MergeTab(2);
            zzcasaa.ChatTabCtrl.MergeTab(3);
            zzcasaa.ChatTabCtrl.MergeTab(4);
            zzcasaa.ChatTabCtrl.SetTopOrder(1, true);
            zzcasaa.HandleTabClick("ChatTabCtrl1");
            // End:0x369
            break;
        // End:0x174
        case 1:
            zzcasaa.ChatTabCtrl.MergeTab(0);
            zzcasaa.ChatTabCtrl.MergeTab(1);
            zzcasaa.ChatTabCtrl.MergeTab(3);
            zzcasaa.ChatTabCtrl.MergeTab(4);
            zzcasaa.ChatTabCtrl.SetTopOrder(2, true);
            zzcasaa.HandleTabClick("ChatTabCtrl2");
            // End:0x369
            break;
        // End:0x21A
        case 2:
            zzcasaa.ChatTabCtrl.MergeTab(0);
            zzcasaa.ChatTabCtrl.MergeTab(1);
            zzcasaa.ChatTabCtrl.MergeTab(2);
            zzcasaa.ChatTabCtrl.MergeTab(4);
            zzcasaa.ChatTabCtrl.SetTopOrder(3, true);
            zzcasaa.HandleTabClick("ChatTabCtrl3");
            // End:0x369
            break;
        // End:0x2C0
        case 3:
            zzcasaa.ChatTabCtrl.MergeTab(0);
            zzcasaa.ChatTabCtrl.MergeTab(1);
            zzcasaa.ChatTabCtrl.MergeTab(2);
            zzcasaa.ChatTabCtrl.MergeTab(3);
            zzcasaa.ChatTabCtrl.SetTopOrder(4, true);
            zzcasaa.HandleTabClick("ChatTabCtrl4");
            // End:0x369
            break;
        // End:0x366
        case 4:
            zzcasaa.ChatTabCtrl.MergeTab(1);
            zzcasaa.ChatTabCtrl.MergeTab(2);
            zzcasaa.ChatTabCtrl.MergeTab(3);
            zzcasaa.ChatTabCtrl.MergeTab(4);
            zzcasaa.ChatTabCtrl.SetTopOrder(0, true);
            zzcasaa.HandleTabClick("ChatTabCtrl0");
            // End:0x369
            break;
        // End:0xFFFF
        default:
            break;
    }
    return;
}

function HandleCloseAllWindow()
{
    Class'UIAPI_WINDOW'.static.HideWindow("SystemMenuWnd");
    return;
}
