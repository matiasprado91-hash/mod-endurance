function HandleShortcutCommand(string param)
{
    local string zzcomandpama;

    // End:0x1E3
    if(ParseString(param, "Command", zzcomandpama))
    {
        switch(zzcomandpama)
        {
            // End:0x3F
            case "CloseAllWindow":
                HandleCloseAllWindow();
                // End:0x1E3
                break;
            // End:0x5B
            case "ShowChatWindow":
                HandleShowChatWindow();
                // End:0x1E3
                break;
            // End:0x78
            case "SetPrevChatType":
                HandleSetPrevChatType();
                // End:0x1E3
                break;
            // End:0x95
            case "SetNextChatType":
                HandleSetNextChatType();
                // End:0x1E3
                break;
            // End:0xC1
            case "ShowStatusWnd":
                Script1.xxToggleOpenCharInfoWnd();
                // End:0x1E3
                break;
            // End:0xEA
            case "ShowSkillWnd":
                Script1.xxToggleOpenMagicSkillWnd();
                // End:0x1E3
                break;
            // End:0x110
            case "ShowActionWnd":
                Script1.xxToggleOpenActionWnd();
                // End:0x1E3
                break;
            // End:0x138
            case "ShowQuestWnd":
                Script1.xxToggleOpenQuestWnd();
                // End:0x1E3
                break;
            // End:0x15A
            case "ShowClanWnd":
                Script1.xxToggleOpenClanWnd();
                // End:0x1E3
                break;
            // End:0x186
            case "HandleShowOptionWnd":
			HandleHideShowWnd("OptionWnd");
                
                // End:0x1E3
                break;
            // End:0x1B1
            case "ShowSystemMenu":
			HandleHideShowWnd("SystemMenuWnd");
                
                // End:0x1E3
                break;
            // End:0x1C9
            case "SelfTarget":
                RequestSelfTarget();
                // End:0x1E3
                break;
            // End:0x1E0
            case "ForceExit":
                RequestExit();
                // End:0x1E3
                break;
				
				
							case "Teleport2k2Wnd":
				if( !IsShowWindow("NewMenu.BtnTeleportMap") )
				{

					return;

				}


				if ( IsShowWindow("NewMenu.BtnTeleportMap") )

				{
					HandleHideShowWnd(zzcomandpama);

				}
				break;
	
				
				
				
				
				
            // End:0xFFFF
            default:
				if ( Left(zzcomandpama,11) == "UserShorcut" )
		{
			Deobfuscated1120(zzcomandpama);
		}
                break;
        }
    }
    else
    {
        return;
    }
}

function HandleHideShowWnd (string WndName)
{
	local WindowHandle Handle;

	Handle = GetHandle(WndName);
	if ( Handle.IsShowWindow() )
	{
		Handle.HideWindow();
	} 
	else 
	{
		Handle.ShowWindow();
	}
}



