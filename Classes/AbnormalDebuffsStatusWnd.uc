function OnClickButton(string param)
{
	switch(param)
	{
        // End:0x24
		case "btnBuffsOptions":
			isshowopenbuffoptin();
            // End:0x2A
			break;
			
			
		        // End:0x2E
		case "btnCloseBuffInfo":
			zzBuffInfo.HideWindow();
            // End:0x7B
			break;
        // End:0x78
		case "skillRemove":
		//   ExecuteCommand(".removebuff " $ string(zzlastzzBuffInfo.ClassID));
         // RequestBypassToServer("BuffEngine_Dispel=" $ string(zzlastzzBuffInfo.ClassID));
		//	RequestBypassToServer("_bpUI buffDispel "$string(zzlastzzBuffInfo.ClassID));
		//	RequestBypassToServer("_LotusUI RemoveBuff "$string(zzlastzzBuffInfo.ClassID));
		RequestBypassToServer("BuffEngine_Dispel="$string(zzlastzzBuffInfo.ClassID));
          
			zzBuffInfo.HideWindow();
            // End:0x7B
			break;	
			
        // End:0xFFFF
		default:
            // End:0x2A
			break;

	}
	return;
}

function isshowopenbuffoptin()
{
    // End:0x3E
	if( IsShowWindow("OpenBuffsOptions") )
	{
		HideWindow("OpenBuffsOptions");
		PlayConsoleSound(EInterfaceSoundType(6));        
	}
	else
	{
		ShowWindowWithFocus("OpenBuffsOptions");
		PlayConsoleSound(EInterfaceSoundType(5));
	}
	return;
}




function OnLButtonDown(WindowHandle a_WindowHandle, int X, int Y)
{
	local Rect abnormalRect;
	local int fasdas2a, col, tmpX, getsizeeee;
	local StatusIconInfo Info;
	local SkillInfo SkillInfo;

	getsizeeee = getclak23aa(GetOptionInt("BuffOptions", "AbnormalSize"));
	abnormalRect = Me.GetRect();

	abnormalRect = Me.GetRect();
	tmpX = (X - abnormalRect.nX) - 26;
        // End:0x14B
	if( (tmpX > 0) && tmpX < (abnormalRect.nWidth - 12) )
	{
		fasdas2a = (Y - abnormalRect.nY) / (getsizeeee + 2);
		col = tmpX / (getsizeeee + 2);
		zzStatusIcon.GetItem(fasdas2a, col, Info);
            // End:0x14B
		if( GetSkillInfo(Info.ClassID, Info.Level, SkillInfo) )
		{
			ShowDispelWindow(Info, X, Y);
		}
	}
    
	return;
}





function ShowDispelWindow(StatusIconInfo Info, int X, int Y)
{
    // End:0x13
	if( Info.Name == "" )
	{
		return;
	}
    // End:0x36
	if( !zzBuffInfo.IsShowWindow() )
	{
		zzBuffInfo.ShowWindow();
	}
	xxGetTextureHandle("AbnormalDebuffsStatusWnd.BuffInfo.Icon_Slot").SetTexture(Info.IconName);
	xxGetTextBoxHandle("AbnormalDebuffsStatusWnd.BuffInfo.skillName").SetText(Info.Name);
	xxGetTextBoxHandle("AbnormalDebuffsStatusWnd.BuffInfo.skillLevel").SetText((GetSystemString(88)$" ")$string(Info.Level));
	zzlastzzBuffInfo = Info;
	zzBuffInfo.MoveTo(X, Y);
	return;
}


function CustomTooltip infotooltipa(string param)
{
	local CustomTooltip ToolTip;
	local DrawItemInfo Info;

	ToolTip.DrawList.Length = 1;
	Info.eType = DIT_TEXT;
	Info.t_strText = param;
	ToolTip.DrawList[0] = Info;
	return ToolTip;
 
}
