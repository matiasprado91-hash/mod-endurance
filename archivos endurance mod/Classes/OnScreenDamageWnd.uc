function xxEmitterDamage(int zzValue, int zzType, int zztargetID, optional bool isCritical)
{
    local Emitter zzdamageEmitter;
    local Actor zzPlayerActor;
    local Pawn zzP;
    local UserInfo zzInfo;

    // End:0x12
    if(!GetPlayerActor(zzPlayerActor))
    {
        return;
    }
    GetTargetInfo(zzInfo);
    // End:0x33
    if(zztargetID != zzInfo.nID)
    {
        return;
    }
    // End:0x150
    foreach zzPlayerActor.CollidingActors(Class'Pawn', zzP, 5, zzInfo.Loc)
    {
        // End:0x14F
        if(zztargetID == zzP.CreatureID)
        {
            zzdamageEmitter = zzP.Spawn(target_damage, zzP);
            switch(zzType)
            {
                // End:0xB4
                case 7:
                    zzdamageEmitter.Tag = 'OVERHIT';
                    // End:0x12F
                    break;
                // End:0xD2
                case 8:
                    zzdamageEmitter.Tag = 'Critical';
                    // End:0x12F
                    break;
                // End:0xF0
                case 9:
                    zzdamageEmitter.Tag = 'bLocked';
                    // End:0x12F
                    break;
                // End:0x10E
                case 10:
                    zzdamageEmitter.Tag = 'RESISTED';
                    // End:0x12F
                    break;
                // End:0x12C
                case 11:
                    zzdamageEmitter.Tag = 'evaded';
                    // End:0x12F
                    break;
                // End:0xFFFF
                default:
                    break;
            }
            zzdamageEmitter.TransientSoundVolume = float(zzValue);
            zzdamageEmitter = none;
            // End:0x150
            break;
        }        
    }    
    return;
}

function xxSetTextToTex(int Value, int Type, optional int zztargetID)
{
    local int i, W, h, U, V, tmpContainer;

    local string tmpValue, tmpDigit;
    local TextureHandle tmpDigitTex[10];
    local int offsetX, offsetY;
	local UserInfo zztarget;



    lastContainer++;
    // End:0x32
    if((Value < -1) || Value > 999999999)
    {
        Value = 999999999;
    }
    tmpValue = formatByType(Type, string(Value));
    // End:0x5D
    if(lastContainer >= 20)
    {
        lastContainer = 0;
    }
    tmpContainer = lastContainer;
	


  GetTargetInfo(zztarget);
  
    if ( zztargetID == 0)
	
	{
		zztargetID = zztarget.nID;
    }

	
	
    // End:0x9E
    if(isOnTarget(Type))
    {
		
	//	OMG(string(targetID));
        xxEmitterDamage(Value, Type, zztargetID, isCritical);
        isCritical = false;
        return;        
    }
    else
    {
        GetOffset(Type, offsetX, offsetY);
        wContainer[tmpContainer].MoveTo(offsetX - ((Len(tmpValue) * 24) / 2), offsetY);
    }
    i = 0;
    J0xEA:

    // End:0x162 [Loop If]
    if(i < 10)
    {
        tmpDigitTex[i] = xxGetTextureHandle((("OnScreenDamageWnd.Damage" $ string(tmpContainer)) $ "Wnd.Digit") $ string(i));
        tmpDigitTex[i].SetWindowSize(0, 0);
        ++i;
        // [Loop Continue]
        goto J0xEA;
    }
    // End:0x1C6
    if(tmpValue == "")
    {
        getSpecInfo(Type, W, h, U, V);
        tmpDigitTex[0].SetUV(U, V);
        tmpDigitTex[0].SetWindowSize(W, h);        
    }
    else
    {
        i = 0;
        J0x1CD:

        // End:0x3C6 [Loop If]
        if(i < Len(tmpValue))
        {
            tmpDigit = Right(Left(tmpValue, i + 1), 1);
            // End:0x23F
            if(tmpDigit == "+")
            {
                tmpDigitTex[i].SetUV(160, Type * 24);
                tmpDigitTex[i].SetWindowSize(45, 24);                
            }
            else
            {
                // End:0x283
                if((Type == 0) && isCritical)
                {
                    tmpDigitTex[i].SetUV(int(tmpDigit) * 16, 2 * 24);                    
                }
                else
                {
                    tmpDigitTex[i].SetUV(int(tmpDigit) * 16, Type * 24);
                }
                tmpDigitTex[i].SetWindowSize(16, 24);
            }
            // End:0x3BC
            if(i >= 1)
            {
                // End:0x356
                if((Left(tmpValue, 1) == "+") && i == 1)
                {
                    tmpDigitTex[i].SetAnchor((("OnScreenDamageWnd.Damage" $ string(tmpContainer)) $ "Wnd.Digit") $ string(i - 1), "TopLeft", "TopLeft", 45, 0);
                    // [Explicit Continue]
                    goto J0x3BC;
                }
                tmpDigitTex[i].SetAnchor((("OnScreenDamageWnd.Damage" $ string(tmpContainer)) $ "Wnd.Digit") $ string(i - 1), "TopLeft", "TopLeft", 16, 0);
            }
            J0x3BC:

            i++;
            // [Loop Continue]
            goto J0x1CD;
        }
    }
    wContainer[tmpContainer].ShowWindow();
    // End:0x437
    if((getMovePos(Type)) < 0)
    {
    //    wContainer[tmpContainer].Move(0, getMovePos(Type), 1.3);
   //     Me.SetTimer(-tmpContainer + 30000, 300); 
        wContainer[tmpContainer].Move(0, getMovePos(Type), 0.3);
        Me.SetTimer(tmpContainer + 30000, 300);   
    }
    else
    {
        wContainer[tmpContainer].Move(0, getMovePos(Type), 0.3);
        Me.SetTimer(tmpContainer + 30000, 300);
    }
    isCritical = false;
    return;
}

function getTargetOffset(int Type, out int offsetX, out int offsetY)
{
    switch(Type)
    {
        // End:0x29
        case 0:
            offsetX = Rand(100) - 50;
            offsetY = Rand(50);
            // End:0xA8
            break;
        // End:0x4F
        case 8:
            offsetX = Rand(100) - 50;
            offsetY = Rand(20) - 30;
            // End:0xA8
            break;
        // End:0x71
        case 7:
            offsetX = Rand(100);
            offsetY = Rand(50) - 30;
            // End:0xA8
            break;
        // End:0x78
        case 10:
        // End:0x7F
        case 9:
        // End:0xA5
        case 11:
            offsetX = Rand(100) - 50;
            offsetY = Rand(30) + 100;
            // End:0xA8
            break;
        // End:0xFFFF
        default:
            break;
    }
    return;
}

function GetOffset(int Type, out int offsetX, out int offsetY)
{
    switch(Type)
    {
        // End:0x2D
        case 1:
            offsetX = 30 + Rand(30);
            offsetY = 100 + Rand(10);
            // End:0xCD
            break;
        // End:0x50
        case 2:
            offsetX = -100 + Rand(50);
            offsetY = 40;
            // End:0xCD
            break;
        // End:0x73
        case 4:
            offsetX = -100 + Rand(50);
            offsetY = 60;
            // End:0xCD
            break;
        // End:0x96
        case 3:
            offsetX = -100 + Rand(50);
            offsetY = 80;
            // End:0xCD
            break;
        // End:0xB0
        case 5:
            offsetX = 100;
            offsetY = 70;
            // End:0xCD
            break;
        // End:0xCA
        case 6:
            offsetX = 100;
            offsetY = 93;
            // End:0xCD
            break;
        // End:0xFFFF
        default:
            break;
    }
    return;
}

function bool isOnTarget(int Type)
{
    switch(Type)
    {
        // End:0x0E
        case 0:
        // End:0x15
