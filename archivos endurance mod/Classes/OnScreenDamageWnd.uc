function string formatByType(int Type, string Value)
{
    local string tmp;

    switch(Type)
    {
        // End:0x0E
        case 0:
        // End:0x23
        case 1:
            tmp = Value;
            // End:0x8A
            break;
        // End:0x2A
        case 2:
        // End:0x31
        case 4:
        // End:0x38
        case 3:
        // End:0x3F
        case 5:
        // End:0x59
        case 6:
            tmp = "+" $ Value;
            // End:0x8A
            break;
        // End:0x60
        case 8:
        // End:0x67
        case 7:
        // End:0x6E
        case 9:
        // End:0x75
        case 11:
        // End:0x87
        case 10:
            tmp = "";
            // End:0x8A
            break;
        // End:0xFFFF
        default:
            break;
    }
    return tmp;
}

function int getMovePos(int Type)
{
    switch(Type)
    {
        // End:0x0E
        case 2:
        // End:0x15
        case 4:
        // End:0x22
        case 3:
            return -100;
        // End:0x29
        case 0:
        // End:0x30
        case 8:
        // End:0x43
        case 7:
            return -100 - Rand(30);
        // End:0x4A
        case 9:
        // End:0x51
        case 11:
        // End:0x5B
        case 10:
            return 30;
        // End:0x62
        case 5:
        // End:0x69
        case 6:
        // End:0x73
        case 1:
            return 100;
        // End:0xFFFF
        default:
            break;
    }
}

