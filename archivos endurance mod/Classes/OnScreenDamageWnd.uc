}

function OnLoad()
{
    local int i, j;

    OnRegisterEvent();
    Me = xxGetWindowHandle("OnScreenDamageWnd");
    i = 0;
    J0x2C:

    // End:0x105 [Loop If]
    if(i < 20)
    {
        wContainer[i] = xxGetWindowHandle(("OnScreenDamageWnd.Damage" $ string(i)) $ "Wnd");
        j = 0;
        J0x7B:

        // End:0xFB [Loop If]
        if(j < 10)
        {
            xxGetTextureHandle((("OnScreenDamageWnd.Damage" $ string(i)) $ "Wnd.Digit") $ string(j)).SetTexture("L2UI_CH3.DamageWnd.texDigitsNew");
            j++;
            // [Loop Continue]
            goto J0x7B;
        }
        i++;
        // [Loop Continue]
        goto J0x2C;
    }
    target_damage = class<Emitter>(DynamicLoadObject("OMGzOMGEffect.target_damage", Class'Class'));
    return;
}

function OnTimer(int TimerID)
{
    local bool isNegative;
    local int tmpTimer;

    // End:0x28
    if(TimerID < 0)
    {
        isNegative = true;
        tmpTimer = int(Mid(string(TimerID), 1));        
    }
    else
    {
        tmpTimer = TimerID;
    }
    // End:0xEE
    if(tmpTimer >= 30000)
    {
        // End:0x9B
        if(!isNegative)
        {
            wContainer[tmpTimer - 30000].Move(0, 100, 2);
            Me.SetTimer((tmpTimer - 30000) + 20000, 1000);            
        }
        else
        {
            wContainer[tmpTimer - 30000].Move(0, -100, 2);
            Me.SetTimer(-(tmpTimer - 30000) + 20000, 1000);
        }        
    }
    else
    {
        // End:0x1A3
        if(tmpTimer >= 20000)
        {
            // End:0x153
            if(!isNegative)
            {
                wContainer[tmpTimer - 20000].Move(0, 100, 0.05);
                Me.SetTimer((tmpTimer - 20000) + 10000, 40);                
            }
            else
            {
                wContainer[tmpTimer - 20000].Move(0, -100, 0.05);
                Me.SetTimer(-(tmpTimer - 20000) + 10000, 40);
            }            
        }
        else
        {
            // End:0x1CE
            if(tmpTimer >= 10000)
            {
                wContainer[tmpTimer - 10000].HideWindow();
            }
        }
    }
    Me.KillTimer(TimerID);
    return;
}

