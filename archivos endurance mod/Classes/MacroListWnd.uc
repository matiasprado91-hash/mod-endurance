class MacroListWnd extends UICommonAPI;

const MACRO_MAX_COUNT = 24;
const MACROICON_MAX_COUNT = 105;
const MACRO_ICONANME = "L2UI.MacroWnd.Macro_Icon";
const TIMER_MACRO = 90001;
const DELAY_MACRO = 1000;

var bool m_bShow;
var int m_DeleteID;
var int m_Max;
var WindowHandle Me;
var bool m_Cycle;
var int m_CycleID;
var int m_CycleIndex;
var array<string> m_Commands;

function OnLoad()
{
	RegisterEvent(1710);
	RegisterEvent(1230);
	RegisterEvent(1240);
	RegisterEvent(1250);
	Me = GetHandle("MacroListWnd");
	m_bShow = False;
	m_DeleteID = 0;
	m_CycleID = -1;
	return;
}

function OnEnterState(name a_PreStateName)
{
	Class'MacroAPI'.static.RequestMacroList();
	return;
}

function OnShow()
{
	m_bShow = True;
	return;
}

function OnHide()
{
	m_bShow = False;
	HideWindow("MacroEditWnd");
	return;
}

function OnClickButton(string strID)
{
	switch(strID)
	{
        // End:0x1C
		case "btnHelp":
			OnClickHelp();
            // End:0x33
			break;
        // End:0x30
		case "btnAdd":
			OnClickAdd();
            // End:0x33
			break;
        // End:0xFFFF
		default:
			break;
	}
	return;
}

function OnEvent(int Event_ID, string param)
{
    // End:0x18
	if( Event_ID == 1230 )
	{
		HandleMacroShowListWnd();        
	}
	else
	{
        // End:0x30
		if( Event_ID == 1240 )
		{
			HandleMacroUpdate();            
		}
		else
		{
            // End:0x4D
			if( Event_ID == 1250 )
			{
				HandleMacroList(param);                
			}
			else
			{
                // End:0xB3
				if( Event_ID == 1710 )
				{
                    // End:0xB3
					if( DialogIsMine() )
					{
                        // End:0xB3
						if( m_DeleteID > 0 )
						{
							Class'MacroAPI'.static.RequestDeleteMacro(m_DeleteID);
                            // End:0x99
							if( m_DeleteID == m_CycleID )
							{
								StopMacro();
							}
							m_DeleteID = 0;
                            // End:0xB3
							if( m_Max == 1 )
							{
								HandleMacroList("");
							}
						}
					}
				}
			}
		}
	}
	return;
}

function OnTimer(int TimerID)
{
	switch(TimerID)
	{
        // End:0x18
		case 90001:
			ExecMacro();
            // End:0x1B
			break;
        // End:0xFFFF
		default:
			break;
	}
	return;
}

function OnClickItem(string strID, int Index)
{
	local ItemInfo infItem;

    // End:0x6A
	if( (strID == "MacroItem") && Index > -1 )
	{
        // End:0x6A
		if( Class'UIAPI_ITEMWINDOW'.static.GetItem("MacroListWnd.MacroItem", Index, infItem) )
		{
			RequestUseMacro(infItem.ClassID);
		}
	}
	return;
}



function StopMacro()
{
	m_CycleID = -1;
	Me.KillTimer(90001);
	return;
}

function SetMacro(int ClassID)
{
	local MacroInfo m_Info;
	local int i;
	local array<string> arrClear;

	m_Commands = arrClear;
    // End:0x22
	if( !GetMacroInfo(ClassID, m_Info) )
	{
		return;
	}
	i = 0;
J0x29:

    // End:0x73 [Loop If]
	if( i < 12 )
	{
        // End:0x69
		if( m_Info.CommandList[i] != "" )
		{
			m_Commands[m_Commands.Length] = m_Info.CommandList[i];
		}
		i++;
        // [Loop Continue]
		goto J0x29;
	}
	m_CycleIndex = 0;
	ExecMacro();

}

function ExecMacro()
{
	local int tmpTimer;

	tmpTimer = 1;
    // End:0x1E
	if( m_CycleIndex >= m_Commands.Length )
	{
		m_CycleIndex = 0;
	}
    // End:0x54
	if( InStr(m_Commands[m_CycleIndex], "/delay") > -1 )
	{
		tmpTimer = int(Mid(m_Commands[m_CycleIndex], 6));
	}
	ExecuteCommand(m_Commands[m_CycleIndex]);
	m_CycleIndex++;
	Me.KillTimer(90001);
	Me.SetTimer(90001, tmpTimer * 1000);
  
}

function SetOnTex()
{
	local ItemInfo infItem;
	local int i;

	i = 0;
J0x07:

    // End:0xDD [Loop If]
	if( i < 24 )
	{
        // End:0x4B
		if( !Class'UIAPI_ITEMWINDOW'.static.GetItem("MacroListWnd.MacroItem", i, infItem) )
		{
			return;
		}
		infItem.ForeTexture = "";
        // End:0xA2
		if( infItem.ClassID == m_CycleID )
		{
			infItem.ForeTexture = "l2_skilltime.ToggleEffect.ToggleEffect001";
		}
		Class'UIAPI_ITEMWINDOW'.static.SetItem("MacroListWnd.MacroItem", i, infItem);
		i++;
        // [Loop Continue]
		goto J0x07;
	}
 
}

function RequestUseMacro(int ClassID)
{
	Class'MacroAPI'.static.RequestUseMacro(ClassID);
  
}

function bool GetMacroInfo(int ClassID, out MacroInfo m_Info)
{
	return Class'UIDATA_MACRO'.static.GetMacroInfo(ClassID, m_Info);
  
}

function OnClickHelp()
{
	local string strParam;

	ParamAdd(strParam, "FilePath", "..\\L2text\\help_macro.htm");
	ExecuteEvent(1210, strParam);
  
}

function OnClickAdd()
{
	Class'UIAPI_MULTIEDITBOX'.static.SetString("MacroInfoWnd.txtInfo", "");
	ExecuteEvent(1260, "");

}

function HandleMacroUpdate()
{
	Class'MacroAPI'.static.RequestMacroList();

}

function HandleMacroShowListWnd()
{
    // End:0x31
	if( m_bShow )
	{
		PlayConsoleSound(EInterfaceSoundType(6));
		Class'UIAPI_WINDOW'.static.HideWindow("MacroListWnd");        
	}
	else
	{
		PlayConsoleSound(EInterfaceSoundType(5));
		Class'UIAPI_WINDOW'.static.ShowWindow("MacroListWnd");
		Class'UIAPI_WINDOW'.static.SetFocus("MacroListWnd");
	}
	return;
}

function Clear()
{
	Class'UIAPI_ITEMWINDOW'.static.Clear("MacroListWnd.MacroItem");
	return;
}

function HandleMacroList(string param)
{
	local int idx, Max, MacroID;
	local string strIconName, strMacroName, strDescription, strTexture, strTmp;

	local ItemInfo infItem;

	Clear();
	ParseInt(param, "Max", Max);
	m_Max = Max;
	idx = 0;
J0x2D:

    // End:0x21C [Loop If]
	if( idx < Max )
	{
		MacroID = 0;
		strIconName = "";
		strMacroName = "";
		strDescription = "1";
		strTexture = "";
		ParseInt(param, "ID_"$string(idx), MacroID);
		ParseString(param, "IconName_"$string(idx), strIconName);
		ParseString(param, "MacroName_"$string(idx), strMacroName);
		ParseString(param, "Description_"$string(idx), strDescription);
		ParseString(param, "TextureName_"$string(idx), strTexture);
		infItem.ClassID = MacroID;
		infItem.Name = strMacroName;
		infItem.AdditionalName = strIconName;
		infItem.IconName = "L2UI.MacroWnd.Macro_Icon"$strDescription;
		infItem.Description = strDescription;
		infItem.ItemSubType = 4;
		infItem.ForeTexture = "";
        // End:0x1E6
		if( m_CycleID == MacroID )
		{
			infItem.ForeTexture = "l2_skilltime.ToggleEffect.ToggleEffect001";
		}
		Class'UIAPI_ITEMWINDOW'.static.AddItem("MacroListWnd.MacroItem", infItem);
		idx++;
        // [Loop Continue]
		goto J0x2D;
	}
    // End:0x238
	if( Max < 10 )
	{
		strTmp = strTmp$"0";
	}
	strTmp = strTmp$string(Max);
	strTmp = ((("("$strTmp)$"/")$string(24))$")";
	Class'UIAPI_TEXTBOX'.static.SetText("MacroListWnd.txtCount", strTmp);
	return;
}

function OnDropItem(string strID, ItemInfo infItem, int X, int Y)
{
	switch(strID)
	{
        // End:0x22
		case "btnTrash":
			DeleteMacro(infItem);
            // End:0x3F
			break;
        // End:0x3C
		case "btnEdit":
			EditMacro(infItem);
            // End:0x3F
			break;
        // End:0xFFFF
		default:
			break;
	}
	return;
}

function DeleteMacro(ItemInfo infItem)
{
	local string strMsg;

    // End:0x15
	if( infItem.ItemSubType != 4 )
	{
		return;
	}
	strMsg = MakeFullSystemMsg(GetSystemMessage(828), infItem.Name, "");
	m_DeleteID = infItem.ClassID;
	DialogShow(EDialogType(4), strMsg);
	return;
}

function EditMacro(ItemInfo infItem)
{
	local int MacroID;
	local string param;

    // End:0x15
	if( infItem.ItemSubType != 4 )
	{
		return;
	}
	MacroID = infItem.ClassID;
	ParamAdd(param, "MacroID", string(MacroID));
	ExecuteEvent(1260, param);
	return;
}
