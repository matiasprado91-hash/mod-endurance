	{
		Cb_SP.SetCheck(True);        
	}
	else
	{
		Cb_SP.SetCheck(False);
	}
	 
	bOption = GetOptionBool("ScreenDamage", "missed");
	if( bOption == True )
	{
		Cb_Miss.SetCheck(True);        
	}
	else
	{
		Cb_Miss.SetCheck(False);
	}
	bOption = GetOptionBool("ScreenDamage", "resisted");
	if( bOption == True )
	{
		Cb_Resist.SetCheck(True);        
	}
	else
	{
		Cb_Resist.SetCheck(False);
	}
	bOption = GetOptionBool("ScreenDamage", "blocked");
