		SetKeyCrypt(bChecked);
	}
	nSelectedNum = xxGetComboBoxHandle("OptionWnd.cbBuffSize").GetSelectedNum();
	SetOptionInt("Game", "BuffSize", nSelectedNum);
	return;
}
 
function ApplyConfigs()
{
	ApplyVideoOption();
	ApplyAudioOption();
	ApplyGameOption();
	return;
}
 
function OnClickButton(string strID)
{
	Debug(strID);
	switch(strID)
	{
		 // End:0x28
		case "ApplyBtn":
			ApplyConfigs();
			 // End:0x1B9
			break;
		 // End:0x70
		case "ApplyCloseBtn":
			ApplyConfigs();
			SetOptionInt("FirstRun", "FirstRun", 2);
			HideWindow("OptionWnd");
			 // End:0x1B9
			break;
		 // End:0x15A
		case "CloseBtn":
			SetOptionInt("FirstRun", "FirstRun", 2);
			 // End:0x146
			if( GetOptionBool("Audio", "AudioMuteOn") == False )
			{
				OnModifyCurrentTickSliderCtrl("EffectVolumeSliderCtrl", m_iPrevSoundTick);
				OnModifyCurrentTickSliderCtrl("MusicVolumeSliderCtrl", m_iPrevMusicTick);
				OnModifyCurrentTickSliderCtrl("SystemVolumeSliderCtrl", m_iPrevSystemTick);
				OnModifyCurrentTickSliderCtrl("TutorialVolumeSliderCtrl", m_iPrevTutorialTick);
			}
			HideWindow("OptionWnd");
			 // End:0x1B9
			break;
		 // End:0x175
		case "WindowInitBtn":
			SetDefaultPosition();
			 // End:0x1B9
			break;
		 // End:0x18B
		case "btnVideo":
			SetTabVideo();
			 // End:0x1B9
			break;
		 // End:0x1A1
		case "btnAudio":
			SetTabAudio();
			 // End:0x1B9
			break;
		 // End:0x1B6
		case "btnGame":
			SetTabGame();
			 // End:0x1B9
			break;
		 // End:0x1CD
		case "btnDamage":
			SetTabDamage();
			 // End:0x1D0
			break;
		case "btnOn":
			EnableAll();
			break;
		case "btnOff":
			DisableAll();
			break;	
			 
		 // End:0xFFFF
		default:
			break;
	}
	return;
}
 
function SetTabVideo()
{
	showTabVideo = True;
	showTabAudio = False;
	showTabGame = False;
	ShowTabDamage = False;
	ShowHideTab(showTabVideo, showTabAudio, showTabGame, ShowTabDamage);
	return;
}
 
function SetTabAudio()
{
	showTabVideo = False;
	showTabAudio = True;
	showTabGame = False;
	ShowTabDamage = False;
	ShowHideTab(showTabVideo, showTabAudio, showTabGame, ShowTabDamage);
	return;
}
 
function SetTabGame()
{
	showTabVideo = False;
	showTabAudio = False;
	showTabGame = True;
	ShowTabDamage = False;
	ShowHideTab(showTabVideo, showTabAudio, showTabGame, ShowTabDamage);
	return;
}
 
function SetTabDamage()
{
	showTabVideo = False;
	showTabAudio = False;
	showTabGame = False;
	ShowTabDamage = True;
	ShowHideTab(showTabVideo, showTabAudio, showTabGame, ShowTabDamage);
	return;
}
 
 
 
 
function ShowHideTab(bool bvideo, bool baudio, bool bgame, bool bDamage)
{
	 // End:0x8C
	if( bvideo )
	{
		ShowWindow("VideoTab");
		btnVideo.SetTexture("L2UI_CH3.OptionWnd.btnTabOn", "L2UI_CH3.OptionWnd.btnTabOn_over", "L2UI_CH3.OptionWnd.btnTabOn_over");        
	}
	else
	{
		HideWindow("VideoTab");
		btnVideo.SetTexture("L2UI_CH3.OptionWnd.btnTab", "L2UI_CH3.OptionWnd.btnTab_over", "L2UI_CH3.OptionWnd.btnTab_over");
	}
	 // End:0x192
	if( baudio )
	{
		ShowWindow("AudioTab");
		btnAudio.SetTexture("L2UI_CH3.OptionWnd.btnTabOn", "L2UI_CH3.OptionWnd.btnTabOn_over", "L2UI_CH3.OptionWnd.btnTabOn_over");        
	}
	else
	{
		HideWindow("AudioTab");
		btnAudio.SetTexture("L2UI_CH3.OptionWnd.btnTab", "L2UI_CH3.OptionWnd.btnTab_over", "L2UI_CH3.OptionWnd.btnTab_over");
	}
	 // End:0x297
	if( bgame )
	{
		ShowWindow("GameTab");
		btnGame.SetTexture("L2UI_CH3.OptionWnd.btnTabOn", "L2UI_CH3.OptionWnd.btnTabOn_over", "L2UI_CH3.OptionWnd.btnTabOn_over");        
	}
	else
	{
		HideWindow("GameTab");
		btnGame.SetTexture("L2UI_CH3.OptionWnd.btnTab", "L2UI_CH3.OptionWnd.btnTab_over", "L2UI_CH3.OptionWnd.btnTab_over");
	}
	 
		 // End:0x39D
	if( bDamage )
	{
		ShowWindow("DamageTab");
		btnDamage.SetTexture("L2UI_CH3.OptionWnd.btnTabOn", "L2UI_CH3.OptionWnd.btnTabOn_over", "L2UI_CH3.OptionWnd.btnTabOn_over");        
	}
	else
	{
		HideWindow("DamageTab");
		btnDamage.SetTexture("L2UI_CH3.OptionWnd.btnTab", "L2UI_CH3.OptionWnd.btnTab_over", "L2UI_CH3.OptionWnd.btnTab_over");
	}
	 
	 
	 
	 
	return;
}
 
function float GetVolumeFromSliderTick(int iTick)
{
	local float fReturnVolume;
 
	switch(iTick)
	{
		 // End:0x19
		case 0:
			fReturnVolume = 0;
			 // End:0x7A
			break;
		 // End:0x2B
		case 1:
			fReturnVolume = 0.2;
			 // End:0x7A
			break;
		 // End:0x3E
		case 2:
			fReturnVolume = 0.4;
			 // End:0x7A
			break;
		 // End:0x51
		case 3:
			fReturnVolume = 0.6;
			 // End:0x7A
			break;
		 // End:0x64
		case 4:
			fReturnVolume = 0.8;
			 // End:0x7A
			break;
		 // End:0x77
		case 5:
			fReturnVolume = 1;
			 // End:0x7A
			break;
		 // End:0xFFFF
		default:
			break;
	}
	return fReturnVolume;
	
}
 
 
