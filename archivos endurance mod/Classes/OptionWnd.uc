function ResetRefreshRate(optional int a_nWidth, optional int a_nHeight)
{
	local int i;
 
	GetRefreshRateList(RefreshRateList, a_nWidth, a_nHeight);
	Class'UIAPI_COMBOBOX'.static.Clear("OptionWnd.RefreshRateBox");
	i = 0;
J0x45:
 
	 // End:0xC7 [Loop If]
	if( i < RefreshRateList.Length )
	{
		Debug("RefreshRateList[ i ] "$string(RefreshRateList[i]));
		Class'UIAPI_COMBOBOX'.static.AddString("OptionWnd.RefreshRateBox", string(RefreshRateList[i])$"Hz");
		++i;
		 // [Loop Continue]
		goto J0x45;
	}
	Class'UIAPI_COMBOBOX'.static.SetSelectedNum("OptionWnd.RefreshRateBox", i - 1);
	return;
}
 
function OnLoad()
{
	local int i, nMultiSample;
	local bool bEnableEngSelection;
	local ELanguageType Language;
	local string strResolution;
 
	btnVideo = ButtonHandle(GetHandle("OptionWnd.btnVideo"));
	btnAudio = ButtonHandle(GetHandle("OptionWnd.btnAudio"));
	btnGame = ButtonHandle(GetHandle("OptionWnd.btnGame"));
	btnDamage = ButtonHandle(GetHandle("OptionWnd.btnDamage"));
	 
	btnOn = ButtonHandle(GetHandle("DamageTab.btnOn"));
	BtnOff = ButtonHandle(GetHandle("DamageTab.btnOff"));
 
	Cb_Damage = CheckBoxHandle(GetHandle("DamageTab.nDamage"));
	Cb_HP = CheckBoxHandle(GetHandle("DamageTab.recoverHP"));
	Cb_MP = CheckBoxHandle(GetHandle("DamageTab.recoverMP"));
	Cb_CP = CheckBoxHandle(GetHandle("DamageTab.recoverCP"));
	Cb_EXP = CheckBoxHandle(GetHandle("DamageTab.acquiredXP"));
	Cb_SP = CheckBoxHandle(GetHandle("DamageTab.acquiredSP"));
	Cb_Miss = CheckBoxHandle(GetHandle("DamageTab.missed"));
	Cb_Resist = CheckBoxHandle(GetHandle("DamageTab.resisted"));
	Cb_Block = CheckBoxHandle(GetHandle("DamageTab.blocked"));
	Cb_Critical = CheckBoxHandle(GetHandle("DamageTab.critical"));
	Cb_Overhit = CheckBoxHandle(GetHandle("DamageTab.overhit"));
	Cb_EDamage = CheckBoxHandle(GetHandle("DamageTab.rDamage"));
 
	 
	RegisterEvent(150);
	RegisterEvent(510);
	RegisterEvent(520);
	RegisterEvent(1550);
	RegisterEvent(1560);
	RegisterState("OptionWnd", "GamingState");
	RegisterState("OptionWnd", "LoginState");
	GetShaderVersion(nPixelShaderVersion, nVertexShaderVersion);
	GetResolutionList(ResolutionList);
	SetOptionBool("Game", "HideDropItem", False);
	xxGetComboBoxHandle("OptionWnd.cbBuffSize").AddString("24");
	xxGetComboBoxHandle("OptionWnd.cbBuffSize").AddString("20");
	xxGetComboBoxHandle("OptionWnd.cbBuffSize").AddString("16");
	xxGetComboBoxHandle("OptionWnd.cbBuffSize").AddString("12");
	i = 0;
J0x1BA:
 
	 // End:0x24F [Loop If]
	if( i < ResolutionList.Length )
	{
		strResolution = (((((""$string(ResolutionList[i].nWidth))$"*")$string(ResolutionList[i].nHeight))$" ")$string(ResolutionList[i].nColorBit))$"bit";
		Class'UIAPI_COMBOBOX'.static.AddString("OptionWnd.ResBox", strResolution);
		++i;
		 // [Loop Continue]
		goto J0x1BA;
	}
	ResetRefreshRate();
	nMultiSample = GetMultiSample();
	 // End:0x2B4
	if( 0 == nMultiSample )
	{
		Class'UIAPI_COMBOBOX'.static.SYS_AddString("OptionWnd.AABox", 869);
		Class'UIAPI_WINDOW'.static.DisableWindow("OptionWnd.AABox");        
	}
	else
	{
		 // End:0x32C
		if( 1 == nMultiSample )
		{
			Class'UIAPI_COMBOBOX'.static.SYS_AddString("OptionWnd.AABox", 869);
			Class'UIAPI_COMBOBOX'.static.SYS_AddString("OptionWnd.AABox", 870);
