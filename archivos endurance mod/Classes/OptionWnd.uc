function DisableCb()
{
	Cb_Damage.SetCheck(False);
	Cb_HP.SetCheck(False);
	Cb_MP.SetCheck(False);
	Cb_CP.SetCheck(False);
	Cb_EXP.SetCheck(False);
	Cb_SP.SetCheck(False);
	Cb_Miss.SetCheck(False);
	Cb_Resist.SetCheck(False);
	Cb_Block.SetCheck(False);
	Cb_Critical.SetCheck(False);
	Cb_Overhit.SetCheck(False);
	Cb_EDamage.SetCheck(False);
	Cb_Damage.DisableWindow();
	Cb_HP.DisableWindow();
	Cb_MP.DisableWindow();
	Cb_CP.DisableWindow();
	Cb_EXP.DisableWindow();
	Cb_SP.DisableWindow();
