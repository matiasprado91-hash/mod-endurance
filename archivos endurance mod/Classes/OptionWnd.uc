	SetOptionBool("Notific", "Anuncios", bChecked);
	 
	bChecked = Class'UIAPI_CHECKBOX'.static.IsChecked("GameTab.ShowDropOnScreen");
	SetOptionBool("Lotus_Custom", "ShowDropOnScreen", bChecked);
	 // End:0x8C5
	if( !Class'UIAPI_CHECKBOX'.static.IsChecked("GameTab.ShowDropOnScreen") )
	{
		Class'UIAPI_CHECKBOX'.static.DisableWindow("GameTab.HideDropName");        
	}
	else
	{
		Class'UIAPI_CHECKBOX'.static.EnableWindow("GameTab.HideDropName");
	}
	bChecked = Class'UIAPI_CHECKBOX'.static.IsChecked("GameTab.HideDropName");
	SetOptionBool("Lotus_Custom", "HideDropName", bChecked);
	 
	scriptradar = RadarMapWnd(GetScript("RadarMapWnd"));
