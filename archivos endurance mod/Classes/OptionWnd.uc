function OptBoolT(string DamageText)
{
	SetOptionBool("ScreenDamage", DamageText, True);
}
 
function OptBoolF(string DamageText)
{
	SetOptionBool("ScreenDamage", DamageText, False);
}
 
 
function OnComboBoxItemSelected(string sName, int Index)
{
	// local AbnormalStatusWnd scriptAbnormal;
 
  //   scriptAbnormal = AbnormalStatusWnd(GetScript("AbnormalStatusWnd"));
	Debug(sName);
	switch(sName)
	{
		 // End:0x6A
		case "ResBox":
			ResetRefreshRate(ResolutionList[Index].nWidth, ResolutionList[Index].nHeight);
			 // End:0x8E
			break;
		 // End:0x8B
		case "cbBuffSize":
	//         scriptAbnormal.SetBuffSize();
			 // End:0x8E
			break;
		 // End:0xFFFF
		default:
			break;
	}
	return;
}
