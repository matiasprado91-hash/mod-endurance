	{
		Cb_Block.SetCheck(True);        
	}
	else
	{
		Cb_Block.SetCheck(False);
	}
	bOption = GetOptionBool("ScreenDamage", "critical");
	if( bOption == True )
	{
		Cb_Critical.SetCheck(True);        
