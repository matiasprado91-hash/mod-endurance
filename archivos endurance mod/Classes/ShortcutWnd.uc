	{
		Class'UIAPI_SHORTCUTITEMWINDOW'.static.UpdateShortcut((("ShortcutWnd."$zzm_ShortcutWndName)$"_5.Shortcut")$string(nShortcutNum), nShortcutID);
	}
	return;
}

