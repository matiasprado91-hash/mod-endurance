function OnClickExpandShortcutButton()
{
    // End:0x6E
	if( !m_IsVertical )
	{
        // End:0x1D
		if( zzm_IsExpand5 )
		{
			Reduce();            
		}
		else
		{
            // End:0x2F
			if( zzm_IsExpand4 )
			{
				Expand5();                
			}
			else
			{
                // End:0x41
				if( zzm_IsExpand3 )
				{
					Expand4();                    
				}
				else
				{
                    // End:0x53
					if( zzm_IsExpand2 )
					{
						Expand3();                        
					}
					else
					{
                        // End:0x65
						if( zzm_IsExpand1 )
						{
							Expand2();                            
						}
						else
						{
							Expand1();
						}
					}
				}
			}
		}        
	}
	else
	{
        // End:0x80
		if( zzm_IsExpand5 )
		{
			Reduce();            
		}
		else
		{
            // End:0x92
			if( zzm_IsExpand4 )
			{
				Expand5();                
			}
			else
			{
                // End:0xA4
				if( zzm_IsExpand3 )
				{
					Expand4();                    
				}
				else
				{
                    // End:0xB6
					if( zzm_IsExpand2 )
					{
						Expand3();                        
					}
					else
					{
                        // End:0xC8
						if( zzm_IsExpand1 )
						{
							Expand2();                            
						}
						else
						{
							Expand1();
						}
					}
				}
			}
		}
	}
	ExecuteEvent(693);
	AutoShotWndPosition();
	AutoPotionsWndPosition();

	return;
}

function AutoPotionsWndPosition()
{
	return;
}

function HandleExpandButton()
{
    // End:0x64
	if( zzm_IsShortcutExpand )
	{
		ShowWindow(("ShortcutWnd."$zzm_ShortcutWndName)$".ExpandButton");
		HideWindow(("ShortcutWnd."$zzm_ShortcutWndName)$".ReduceButton");        
	}
	else
	{
		HideWindow(("ShortcutWnd."$zzm_ShortcutWndName)$".ExpandButton");
		ShowWindow(("ShortcutWnd."$zzm_ShortcutWndName)$".ReduceButton");
	}
	return;
}

function OnMinBtn()
{
	local ToolTip script;

	HandleShortcutClear();
	xxArrangeWnd();
	xxExpandWnd();
	script = ToolTip(GetScript("Tooltip"));
	script.setBoolSelect(True);
	ShowWindow("ShortcutWnd.ShortcutWndHorizontal.TooltipMaxBtn");
	HideWindow("ShortcutWnd.ShortcutWndHorizontal.TooltipMinBtn");
	ShowWindow("ShortcutWnd.ShortcutWndVertical.TooltipMaxBtn");
	HideWindow("ShortcutWnd.ShortcutWndVertical.TooltipMinBtn");
	SetINIBool("ShortcutWnd", "l", False, "windowsInfo.ini");
	return;
}

