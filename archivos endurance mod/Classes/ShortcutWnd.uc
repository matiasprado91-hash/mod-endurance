function OnPrevBtn()
{
	local int nNewPage;

	nNewPage = CurrentShortcutPage - 1;
    // End:0x24
	if( 0 > nNewPage )
	{
		nNewPage = 10 - 1;
	}
	SetCurPage(nNewPage);
	return;
}

