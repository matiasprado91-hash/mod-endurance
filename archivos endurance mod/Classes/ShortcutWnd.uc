function OnLoad()
{
	local ToolTip script;
	local bool bMinTooltip;
	local int minTooltip;

	RegisterEvent(630);
	RegisterEvent(640);
	RegisterEvent(660);
	RegisterEvent(650);
	RegisterEvent(590);
	RegisterEvent(600);
	RegisterEvent(610);
	RegisterEvent(620);
	m_IsLocked = GetOptionBool("Game", "IsLockShortcutWnd");
	zzm_IsExpand1 = GetOptionBool("Game", "Is1ExpandShortcutWnd");
	zzm_IsExpand2 = GetOptionBool("Game", "Is2ExpandShortcutWnd");
	zzm_IsExpand3 = GetOptionBool("Game", "Is3ExpandShortcutWnd");
	zzm_IsExpand4 = GetOptionBool("Game", "Is4ExpandShortcutWnd");
	zzm_IsExpand5 = GetOptionBool("Game", "Is5ExpandShortcutWnd");
	m_IsVertical = GetOptionBool("Game", "IsShortcutWndVertical");
	script = ToolTip(GetScript("Tooltip"));
	GetINIBool("ShortcutWnd", "l", minTooltip, "windowsInfo.ini");
	bMinTooltip = bool(minTooltip);
	script.setBoolSelect(!bMinTooltip);
    // End:0x2C4
	if( bMinTooltip )
	{
		HideWindow("ShortcutWnd.ShortcutWndHorizontal.TooltipMaxBtn");
		ShowWindow("ShortcutWnd.ShortcutWndHorizontal.TooltipMinBtn");
		HideWindow("ShortcutWnd.ShortcutWndVertical.TooltipMaxBtn");
		ShowWindow("ShortcutWnd.ShortcutWndVertical.TooltipMinBtn");        
	}
	else
	{
		ShowWindow("ShortcutWnd.ShortcutWndHorizontal.TooltipMaxBtn");
		HideWindow("ShortcutWnd.ShortcutWndHorizontal.TooltipMinBtn");
		ShowWindow("ShortcutWnd.ShortcutWndVertical.TooltipMaxBtn");
		HideWindow("ShortcutWnd.ShortcutWndVertical.TooltipMinBtn");
	}
	xxGetButtonHandle("ShortcutWnd.ShortcutWndHorizontal.TooltipMaxBtn").SetTooltipCustomType(xxMakeTooltipSimpleText("Hide Description"));
	xxGetButtonHandle("ShortcutWnd.ShortcutWndHorizontal.TooltipMinBtn").SetTooltipCustomType(xxMakeTooltipSimpleText("Show Description"));
	xxGetButtonHandle("ShortcutWnd.ShortcutWndHorizontal.KeyBtn").SetTooltipCustomType(xxMakeTooltipSimpleText("Show Shortcuts"));
	xxGetButtonHandle("ShortcutWnd.ShortcutWndVertical.TooltipMaxBtn").SetTooltipCustomType(xxMakeTooltipSimpleText("Hide Description"));
	xxGetButtonHandle("ShortcutWnd.ShortcutWndVertical.TooltipMinBtn").SetTooltipCustomType(xxMakeTooltipSimpleText("Show Description"));
	xxGetButtonHandle("ShortcutWnd.ShortcutWndVertical.KeyBtn").SetTooltipCustomType(xxMakeTooltipSimpleText("Shortcuts"));	
	xxInitShortPageNum();
	return;
}

function OnDefaultPosition()
{
	zzm_IsExpand1 = False;
	zzm_IsExpand2 = False;
	zzm_IsExpand3 = False;
	zzm_IsExpand4 = False;
	zzm_IsExpand5 = False;
	xxSetVertical(False);
	xxInitShortPageNum();
	xxArrangeWnd();
	xxExpandWnd();
	ExecuteEvent(693);
	return;
}

function OnEnterState(name a_PreStateName)
{
	xxArrangeWnd();
	xxExpandWnd();
	AutoShotWndPosition();
	AutoPotionsWndPosition();
    // End:0x21
	if( a_PreStateName == 'LoadingState' )
	{
		xxInitShortPageNum();
	}
    // End:0x35
	if( zzm_IsExpand5 )
	{
		m_Expand = 5;        
	}
	else
	{
        // End:0x49
		if( zzm_IsExpand4 )
		{
			m_Expand = 4;            
		}
		else
		{
            // End:0x5D
			if( zzm_IsExpand3 )
			{
				m_Expand = 3;                
			}
			else
			{
                // End:0x71
				if( zzm_IsExpand2 )
				{
					m_Expand = 2;                    
				}
				else
				{
                    // End:0x84
					if( zzm_IsExpand1 )
					{
						m_Expand = 1;                        
					}
					else
					{
						m_Expand = 0;
					}
				}
			}
		}
	}
    // End:0xC6
	if( GetOptionBool("Lotus_Custom", "ShortcutTransparencyNum") == False )
	{
		xxkeybindshortcut();
	}
	return;
}

function OnEvent(int a_EventID, string a_Param)
{
	switch(a_EventID)
	{
        // End:0x1D
		case 640:
			HandleShortcutPageUpdate(a_Param);
            // End:0xC4
			break;
        // End:0x33
		case 660:
			HandleShortcutJoypad(a_Param);
            // End:0xC4
			break;
        // End:0x49
		case 590:
