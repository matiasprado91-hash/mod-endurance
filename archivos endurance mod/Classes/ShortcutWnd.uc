function HandleShortcutJoypad(string a_Param)
{
	local int OnOff;

    // End:0x95
	if( ParseInt(a_Param, "OnOff", OnOff) )
	{
        // End:0x59
		if( 1 == OnOff )
		{
			m_IsJoypadOn = True;
			ShowWindow(("ShortcutWnd."$zzm_ShortcutWndName)$".JoypadBtn");            
		}
		else
		{
            // End:0x95
			if( 0 == OnOff )
			{
				m_IsJoypadOn = False;
				HideWindow(("ShortcutWnd."$zzm_ShortcutWndName)$".JoypadBtn");
			}
		}
	}
	return;
}

