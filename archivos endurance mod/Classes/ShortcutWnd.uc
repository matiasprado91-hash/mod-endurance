	SetOptionBool("Game", "Is2ExpandShortcutWnd", zzm_IsExpand2);
	SetOptionBool("Game", "Is3ExpandShortcutWnd", zzm_IsExpand3);
	SetOptionBool("Game", "Is4ExpandShortcutWnd", zzm_IsExpand4);
