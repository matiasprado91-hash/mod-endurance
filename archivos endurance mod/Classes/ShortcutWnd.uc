function xxArrangeWnd()
{
	local Rect WindowRect;

    // End:0x140
	if( m_IsJoypad )
	{
		HideWindow("ShortcutWnd.ShortcutWndVertical");
		HideWindow("ShortcutWnd.ShortcutWndHorizontal");
        // End:0xD4
		if( m_IsJoypadExpand )
		{
			HideWindow("ShortcutWnd.ShortcutWndJoypad");
			ShowWindow("ShortcutWnd.ShortcutWndJoypadExpand");
			zzm_ShortcutWndName = "ShortcutWndJoypadExpand";            
		}
		else
		{
			HideWindow("ShortcutWnd.ShortcutWndJoypadExpand");
			ShowWindow("ShortcutWnd.ShortcutWndJoypad");
			zzm_ShortcutWndName = "ShortcutWndJoypad";
		}        
	}
	else
	{
		HideWindow("ShortcutWnd.ShortcutWndJoypadExpand");
		HideWindow("ShortcutWnd.ShortcutWndJoypad");
        // End:0x288
		if( m_IsVertical )
		{
			zzm_ShortcutWndName = "ShortcutWndVertical";
			WindowRect = Class'UIAPI_WINDOW'.static.GetRect("ShortcutWnd.ShortcutWndVertical");
            // End:0x235
			if( WindowRect.nY < 0 )
			{
				Class'UIAPI_WINDOW'.static.MoveTo("ShortcutWnd.ShortcutWndVertical", WindowRect.nX, 0);
			}
			HideWindow("ShortcutWnd.ShortcutWndHorizontal");
			ShowWindow("ShortcutWnd.ShortcutWndVertical");            
		}
		else
		{
			zzm_ShortcutWndName = "ShortcutWndHorizontal";
			WindowRect = Class'UIAPI_WINDOW'.static.GetRect("ShortcutWnd.ShortcutWndHorizontal");
            // End:0x32A
			if( WindowRect.nX < 0 )
			{
				Class'UIAPI_WINDOW'.static.MoveTo("ShortcutWnd.ShortcutWndHorizontal", 0, WindowRect.nY);
			}
			HideWindow("ShortcutWnd.ShortcutWndVertical");
			ShowWindow("ShortcutWnd.ShortcutWndHorizontal");
		}
        // End:0x3AF
		if( m_IsJoypadOn )
		{
			ShowWindow(("ShortcutWnd."$zzm_ShortcutWndName)$".JoypadBtn");            
		}
		else
		{
			HideWindow(("ShortcutWnd."$zzm_ShortcutWndName)$".JoypadBtn");
		}
	}
    // End:0x3EA
	if( m_IsLocked )
	{
		Lock();        
	}
	else
	{
		UnLock();
	}
	SetCurPage(CurrentShortcutPage);
	SetCurPage2(CurrentShortcutPage2);
	SetCurPage3(CurrentShortcutPage3);
	SetCurPage4(CurrentShortcutPage4);
	SetCurPage5(CurrentShortcutPage5);
	SetCurPage6(CurrentShortcutPage6);
    // End:0x44F
	if( zzm_IsExpand1 == True )
	{
		zzm_IsShortcutExpand = True;
		HandleExpandButton();        
	}
	else
	{
        // End:0x46C
		if( zzm_IsExpand2 == True )
		{
			zzm_IsShortcutExpand = False;
			HandleExpandButton();            
		}
		else
		{
            // End:0x489
			if( zzm_IsExpand3 == True )
			{
				zzm_IsShortcutExpand = False;
				HandleExpandButton();                
			}
			else
			{
                // End:0x4A6
				if( zzm_IsExpand4 == True )
				{
					zzm_IsShortcutExpand = False;
					HandleExpandButton();                    
				}
				else
				{
                    // End:0x4C3
					if( zzm_IsExpand5 == True )
					{
						zzm_IsShortcutExpand = False;
						HandleExpandButton();                        
					}
					else
					{
						zzm_IsShortcutExpand = True;
						HandleExpandButton();
					}
				}
			}
		}
	}
	return;
}

function xxExpandWnd()
{
    // End:0xC9
	if( ((((zzm_IsExpand1 == True) || zzm_IsExpand2 == True) || zzm_IsExpand3 == True) || zzm_IsExpand4 == True) || zzm_IsExpand5 == True )
	{
        // End:0x5E
		if( zzm_IsExpand5 == True )
		{
			zzm_IsShortcutExpand = False;
