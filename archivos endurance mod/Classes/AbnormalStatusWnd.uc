    J0x20:

    // End:0xCF [Loop If]
    if(i >= 0)
    {
        ColCount = StatusIcon.GetColCount(i);
        j = ColCount;
        J0x50:

        // End:0xC5 [Loop If]
        if(j >= 0)
        {
            StatusIcon.GetItem(i, j, Info);
            // End:0xBB
            if((Info.ClassID == 98944) && Info.Level == 4)
            {
                StatusIcon.DelItem(i, j);
                return;
            }
            j--;
