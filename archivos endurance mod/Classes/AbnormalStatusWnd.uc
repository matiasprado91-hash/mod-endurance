function asd2a3x11aa34()
{
    local StatusIconInfo Info;
    local int RowCount;

    Info.Size = getclak23aa(GetOptionInt("BuffOptions", "AbnormalDebuffSize"));
    Info.BackTex = "L2UI.etc.AbnormalBack";
    Info.bShow = false;
    Info.bEtcItem = false;
    Info.bShortItem = false;
    Info.ClassID = 98944;
    Info.Level = 4;
    Info.IconName = "";
    RowCount = StatusIcon.GetRowCount();
    StatusIcon.InsertRow(RowCount);
    StatusIcon.AddCol(RowCount, Info);
    return;
}



function OnLButtonUp(WindowHandle a_WindowHandle, int X, int Y)
{
    local Rect abnormalRect;
    local StatusIconInfo Info;
    local SkillInfo SkillInfo;
    local int Row, col, tmpX;

    // End:0x0D
    if(a_WindowHandle == none)
    {
        return;
    }
    // End:0x2F
    if(a_WindowHandle.GetWindowName() != "StatusIcon")
    {
        return;
    }
    abnormalRect = Me.GetRect();
    tmpX = (X - abnormalRect.nX) - 14;
    // End:0x113
    if((tmpX > 0) && tmpX < (abnormalRect.nWidth - 12))
    {
        Row = (Y - abnormalRect.nY) / (getclak23aa(0) + 2); // Reemplazo de GetBuffSize() con getclak23aa(0)
        col = tmpX / (getclak23aa(0) + 2); // Reemplazo de GetBuffSize() con getclak23aa(0)
        StatusIcon.GetItem(Row, col, Info);
        // End:0x113
        if(GetSkillInfo(Info.ClassID, Info.Level, SkillInfo))
        {
            ShowDispelWindow(Info, X, Y);
        }
    }
    return;
}


function ShowDispelWindow(StatusIconInfo Info, int X, int Y)
{
    // End:0x13
    if(Info.Name == "")
    {
        return;
    }
    // End:0x36
    if(!BuffInfo.IsShowWindow())
    {
        BuffInfo.ShowWindow();
    }
    xxGetTextureHandle("AbnormalStatusWnd.buffInfo.Icon_Slot").SetTexture(Info.IconName);
    xxGetTextBoxHandle("AbnormalStatusWnd.buffInfo.skillName").SetText(Info.Name);
    xxGetTextBoxHandle("AbnormalStatusWnd.buffInfo.skillLevel").SetText((GetSystemString(88) $ " ") $ string(Info.Level));
    lastBuffInfo = Info;
    BuffInfo.MoveTo(X, Y);
    return;
}
function OnClickButton(string Str)
{
    switch(Str)
    {
        // End:0x2E
        case "btnCloseBuffInfo":
            BuffInfo.HideWindow();
            // End:0x7B
            break;
        // End:0x78
        case "skillRemove":
            RequestBypassToServer("BuffEngine_Dispel=" $ string(lastBuffInfo.ClassID));
            BuffInfo.HideWindow();
            // End:0x7B
            break;
        // End:0xFFFF
        default:
            break;
    }
    return;
}

