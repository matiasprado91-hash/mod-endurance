class SuperNotifWnd extends UICommonAPI;

const TAB_NUM = 3;
const TAB_OFFSET = 5;

var WindowHandle Me;
var WindowHandle wPage[3];
var TextBoxHandle txtTitle[3];
var TextBoxHandle txtMessage[3];
var TextureHandle texIcon[3];
var int gPage;
var int YPos;
var Rect meRect;

function OnLoad()
{
    local int i;

    RegisterEvent(2900);
    RegisterEvent(99997);
	RegisterEvent( EV_SystemMessage );
    Me = xxGetWindowHandle("SuperNotifWnd");
    i = 0;
    J0x3A:

    // End:0x152 [Loop If]
    if(i < 3)
    {
        wPage[i] = xxGetWindowHandle("SuperNotifWnd.Page" $ string(i));
        txtTitle[i] = xxGetTextBoxHandle(("SuperNotifWnd.Page" $ string(i)) $ ".txtTitle");
        txtMessage[i] = xxGetTextBoxHandle(("SuperNotifWnd.Page" $ string(i)) $ ".txtMessage");
        texIcon[i] = xxGetTextureHandle(("SuperNotifWnd.Page" $ string(i)) $ ".texIcon");
        wPage[i].SetAlpha(0);
        i++;
        // [Loop Continue]
        goto J0x3A;
    }
    gPage = 0;
    return;
}

function OnEvent(int a_EventID, string a_Param)
{
	 local int SystemMsgIndex;
	
    switch(a_EventID)
    {
        // End:0x1D
        case 99997:
            HandleNotification(a_Param);
            // End:0x20
            break;
			        // End:0x1D
        case EV_SystemMessage:
		
			ParseInt ( a_Param, "Index", SystemMsgIndex );

    if (SystemMsgIndex == 2174) // Compara directamente el par??metro con el ID del mensaje
	{
		setNotification(430, 65, 7700, "Has Capturado un Clan Stronghold", "L2ACDC", "htmlBtns.attribute_defence", xxgetInstanceL2Util().Red, xxgetInstanceL2Util().BrightWhite);
	}
      
            // End:0x20
            break;
        // End:0xFFFF
        default:
            break;
    }
    return;
}

function OnTimer(int TimerID)
{
    // End:0x24
    if((TimerID >= 0) && TimerID <= 3)
    {
        initPage(TimerID);
    }
    return;
}

function OnExitState(name State)
{
    ResetPages();
    return;
}

function OnLButtonUp(WindowHandle a_WindowHandle, int X, int Y)
{
    // End:0x37
    if(a_WindowHandle.GetWindowName() == "exitBtn")
    {
        initPage(int(Right(a_WindowHandle.GetParentWindowName(), 1)));
    }
    return;
}

function initPage(int Page)
{
    wPage[Page].KillTimer(Page);
    wPage[Page].SetAlpha(0, 0.2);
    wPage[Page].Move(100, 0, 0.2);
    return;
}

function ResetPages()
{
    local int i;

    i = 0;
    J0x07:

    // End:0x28 [Loop If]
    if(i < 3)
    {
        initPage(i);
        i++;
        // [Loop Continue]
        goto J0x07;
    }
    return;
}

function HandleNotification(string a_Param)
{
    local string pMessage, pTextColor, pTitle, pTitleColor, pIconTexture;

    local int pWidth, pHeight, pTimer, R, G, B;

    local Color colorTitle, colorText;

    ParseString(a_Param, "Notification", pMessage);
    ParseString(a_Param, "Title", pTitle);
    ParseString(a_Param, "TitleColor", pTitleColor);
    ParseString(a_Param, "IconTexture", pIconTexture);
    ParseInt(a_Param, "Width", pWidth);
    ParseInt(a_Param, "Height", pHeight);
    ParseInt(a_Param, "Timer", pTimer);
    ParseString(a_Param, "TextColor", pTextColor);
    ParseInt(pTextColor, "R", R);
    colorText.R = byte(R);
    ParseInt(pTextColor, "G", G);
    colorText.G = byte(G);
    ParseInt(pTextColor, "B", B);
    colorText.B = byte(B);
    ParseString(a_Param, "TitleColor", pTitleColor);
    ParseInt(pTitleColor, "R", R);
    colorTitle.R = byte(R);
    ParseInt(pTitleColor, "G", G);
    colorTitle.G = byte(G);
    ParseInt(pTitleColor, "B", B);
    colorTitle.B = byte(B);
    setNotification(pWidth, pHeight, pTimer, pMessage, pTitle, pIconTexture, colorTitle, colorText);
    return;
}

function setNotification(int pWidth, int pHeight, int pTimer, string pMessage, string pTitle, string pIconTexture, Color pTitleColor, Color pTextColor)
{
    local Rect Rect;
    local int LineLength;
    local string FormattedMessage;
    local int i;
    local int messageLength;
	local int zzmaxcharacter;

    GetINIInt("PatchSettings", "AnunciosMaxCharacters", zzmaxcharacter, "PatchSettings");


    LineLength = zzmaxcharacter; // L??mite de caracteres por l??nea
    FormattedMessage = "";
    messageLength = Len(pMessage);

    // Dividir el mensaje en l??neas de m??ximo LineLength caracteres
    for (i = 0; i < messageLength; i += LineLength)
    {
        if (i + LineLength < messageLength)
        {
            FormattedMessage = FormattedMessage $ Mid(pMessage, i, LineLength) $ "\\n";
        }
        else
        {
            FormattedMessage = FormattedMessage $ Mid(pMessage, i, messageLength - i);
        }
    }

    meRect = Me.GetRect();
    // End:0x64
    if((gPage >= 3) || wPage[0].GetAlpha() == 0)
    {
        gPage = 0;
        YPos = (meRect.nY + meRect.nHeight) - pHeight;
    }
    // End:0x8A
    if(wPage[gPage].GetAlpha() > 0)
    {
        initPage(gPage);
    }
    wPage[gPage].SetWindowSize(pWidth, pHeight);
    txtTitle[gPage].SetTextColor(pTitleColor);
    txtTitle[gPage].SetText(pTitle);
    txtMessage[gPage].SetText(FormattedMessage);
    txtMessage[gPage].SetTextColor(pTextColor);
    texIcon[gPage].SetTexture(pIconTexture);
    wPage[gPage].SetAlpha(255, 0.5);
    Rect = wPage[gPage].GetRect();
    wPage[gPage].MoveTo(((meRect.nX + meRect.nWidth) - Rect.nWidth) + 100, YPos);
    YPos -= (Rect.nHeight + 5);
    wPage[gPage].Move(-100, 0, 0.2);
    // End:0x1ED
    if(pTimer <= 0)
    {
        pTimer = 1000;
    }
    wPage[gPage].SetTimer(gPage, pTimer);
    PlaySound("messengersound.newalert");
    gPage++;
    return;
}


function SetInitPosition(int Width, int Height)
{
    local Rect NotiRect;

    NotiRect = GetHandle("QuestSuperNotifWnd").GetRect();
    Me.ClearAnchor();
    Me.SetAnchor("", "TopLeft", "TopLeft", (NotiRect.nX + NotiRect.nWidth) - Width, NotiRect.nY - (Height + 20));
    return;
}

function int GetPage()
{
    local int i, Page;

    Page = 0;
    i = 0;
    J0x0E:

    // End:0x57 [Loop If]
    if(i < 3)
    {
        // End:0x4D
        if((wPage[i].GetAlpha() == 0) && Page == 0)
        {
            Page = i;
        }
        i++;
        // [Loop Continue]
        goto J0x0E;
    }
    return Page;

}
defaultproperties
{
}
