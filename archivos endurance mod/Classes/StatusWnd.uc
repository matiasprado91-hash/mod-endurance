	return;
}
 
function HandleUpdateInfo(string zzparam)
{
	local int ServerID;
 
	ParseInt(zzparam, "ServerID", ServerID);
	 // End:0x3C
	if( (m_UserID == ServerID) || !m_bReceivedUserInfo )
	{
		UpdateUserInfo();
	}
	return;
}
 
function setwindowsize(string zzparam, int zzvalor, int zzfoint)
{
	local float zzlockua;
 
	zzlockua = float(zzvalor) / float(zzfoint);
	xxGetTextureHandle(zzparam$"C").SetWindowSizeRel(zzlockua, 0, -8, 26);
	 // End:0x61
	if( zzlockua <= float(0) )
	{
		HideWindow(zzparam$"L");        
	}
	else
	{
		ShowWindow(zzparam$"L");
		 // End:0x95
		if( zzlockua < float(1) )
		{
			ShowWindow(zzparam$"Trail");            
		}
		else
		{
			HideWindow(zzparam$"Trail");
		}
	}
	return;
}
 
function sinofuscation(string a_zzparam)
{
	local int zzi, zzmande, zztecrr;
	local float zzsupoerato;
 
	ParseInt(a_zzparam, "Type", zzi);
	 // End:0x6A
	if( zzi == 1 )
	{
		ParseInt(a_zzparam, "Duration", zzmande);
		ParseInt(a_zzparam, "Ticks", zztecrr);
		ParseFloat(a_zzparam, "Amount", zzsupoerato);
	}
	return;
}
 
