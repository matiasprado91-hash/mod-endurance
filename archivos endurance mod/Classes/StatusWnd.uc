function UpdateUserInfo()
{
	local UserInfo UserInfo;
	local int zzlenkg, zzlevel;
	local string zzvetigo;
 
	zzlevel = Len(Class'UIAPI_TEXTBOX'.static.GetText("StatusWnd.StatusWnd_LevelTextBox"));
	 // End:0x2D0
	if( GetPlayerInfo(UserInfo) )
	{
		m_bReceivedUserInfo = True;
		m_UserID = UserInfo.nID;
		setwindowsize("StatusWnd.CPBarTex.CPGauge_", UserInfo.nCurCP, UserInfo.nMaxCP);
		setwindowsize("StatusWnd.HPBarTex.HPGauge_", UserInfo.nCurHP, UserInfo.nMaxHP);
		setwindowsize("StatusWnd.MPBarTex.MPGauge_", UserInfo.nCurMP, UserInfo.nMaxMP);
		Class'UIAPI_NAMECTRL'.static.SetNameWithColor("StatusWnd.UserName", UserInfo.Name, ENameCtrlType(0), ETextAlign(1), getcottt("White"));
		Class'UIAPI_TEXTBOX'.static.SetInt("StatusWnd.StatusWnd_LevelTextBox", UserInfo.nLevel);
		zzm_script_expBar.UpdateExpBar(UserInfo.nCurExp, UserInfo.nLevel);
		zzlenkg = 1;
	J0x1A7:
 
		 // End:0x274 [Loop If]
		if( zzlenkg <= zzlevel )
		{
			zzvetigo = Right(Left(string(UserInfo.nLevel), zzlenkg), 1);
			Class'UIAPI_TEXTURECTRL'.static.SetUV(("StatusWnd."$string(zzlenkg))$"digitolvl", int(zzvetigo) * 12, 0);
			 // End:0x244
			if( zzlevel < 2 )
			{
				HideWindow("StatusWnd.2digitolvl");
				xxAnchorLevelDigit(32, 23);
				 // [Explicit Continue]
				goto J0x26A;
			}
			ShowWindow("StatusWnd.2digitolvl");
			xxAnchorLevelDigit(26, 23);
		J0x26A:
 
			++zzlenkg;
			 // [Loop Continue]
			goto J0x1A7;
		}
		zztxtCP.SetText((string(UserInfo.nCurCP)$"/")$string(UserInfo.nMaxCP));
		zztxtHP.SetText((string(UserInfo.nCurHP)$"/")$string(UserInfo.nMaxHP));
		zztxtMP.SetText((string(UserInfo.nCurMP)$"/")$string(UserInfo.nMaxMP));
	}
	return;
}
 
function xxAnchorLevelDigit(int X, int Y)
{
	Class'UIAPI_WINDOW'.static.SetAnchor("StatusWnd.1digitolvl", "StatusWnd", "TopLeft", "TopLeft", X, Y);
	Class'UIAPI_WINDOW'.static.SetAnchor("StatusWnd.2digitolvl", "StatusWnd", "TopLeft", "TopLeft", X + 10, Y);
	return;
}
 
function OnLButtonDown(WindowHandle a_WindowHandle, int X, int Y)
{
	local Rect zzrectWnd;
 
	zzrectWnd = Class'UIAPI_WINDOW'.static.GetRect("StatusWnd");
	 // End:0x64
	if( (X > (zzrectWnd.nX + 13)) && X < ((zzrectWnd.nX + zzrectWnd.nWidth) - 10) )
	{
		RequestSelfTarget();
	}
	 // End:0xA5
	if( (X >= zzrectWnd.nX) && X <= (zzrectWnd.nX + 40) )
	{
		zzMe.SetDraggable(True);        
	}
	else
	{
		zzMe.SetDraggable(False);
	}
	return;
}
 
