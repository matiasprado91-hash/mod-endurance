class TrueWnd extends UICommonAPI;


var WindowHandle Me;
var string vsalkam2a;
var string basd2ax2;
var string asca2x2a;
var EInputKey vascasda2ax;
var bool avada2xa2;
var EInputKey acas2axca22;
var bool acas2ax2ax;
var string zzlogo;
var string zztext;

function OnShow()
{

	local L2Util zzutilbar;
	zzutilbar = L2Util(GetScript("L2Util"));

	Me = GetHandle("TrueWnd");
	HideWindow("LoginFunctionWnd");
	HideWindow("MessageWnd");
	xxGetWindowHandle("TrueWnd.alert").SetAlpha(0);
	xxGetWindowHandle("AuthWnd").SetAnchor("", "CenterCenter", "CenterCenter", 0, 62);
	xxGetTextureHandle("TrueWnd.ID.idtex").SetTexture("L2UI_CH3.LoginWnd.editboxlogin_overa");
	xxGetTextureHandle("TrueWnd.ID.passtex").SetTexture("L2UI_CH3.LoginWnd.editboxlogin_overa");
	GetINIString("PatchSettings", "LOGO_PATH", zzlogo, "PatchSettings");
	xxGetTextureHandle("TrueWnd.Logo").SetTexture(zzlogo);
	GetINIString("PatchSettings", "BOTTOM_TEXT", zztext, "PatchSettings");
	xxGetTextBoxHandle("TrueWnd.nc").SetText(zztext);
	return;
}

function OnClickButton(string id)
{
	switch(id)
	{
        // End:0x1E
		case "btnReplay":
			replayinfo();
            // End:0x38
			break;
        // End:0x35
		case "btnOption":
			optioninfo();
            // End:0x38
			break;
        // End:0xFFFF
		default:
			break;
	}
	return;
}

function optioninfo()
{
    // End:0x28
	if( IsShowWindow("OptionWnd") )
	{
		HideWindow("OptionWnd");        
	}
	else
	{
		ShowWindowWithFocus("OptionWnd");
	}
	return;
}

function replayinfo()
{
	SetUIState("ReplaySelectState");
	return;
}

function OnTick()
{
    // End:0xBD
	if( xxGetWindowHandle("MessageWnd").IsShowWindow() )
	{
		HideWindow("MessageWnd");
		xxGetTextBoxHandle("TrueWnd.alert").SetText("ID or Password Incorrect - Try Again!");
		xxGetWindowHandle("TrueWnd.alert").SetAlpha(255);
		xxGetWindowHandle("TrueWnd.alert").SetAlpha(0, 255);
	}
	return;
}
