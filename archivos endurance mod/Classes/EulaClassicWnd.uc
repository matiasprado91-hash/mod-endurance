class EulaClassicWnd extends UICommonAPI;

function OnShow()
{
	local L2Util zzutilbar;
	local string zztext;
	zzutilbar = L2Util(GetScript("L2Util"));
	
	xxGetWindowHandle("EulaWnd").SetAnchor("", "CenterCenter", "CenterCenter", 0, 40);
	HideWindow("MessageWnd");
	Class'UIAPI_WINDOW'.static.ShowWindow("EulaClassicWnd.VK_TEXT");
	GetINIString("PatchSettings", "BOTTOM_TEXT", zztext, "PatchSettings");
	Class'UIAPI_TEXTBOX'.static.SetText("EulaClassicWnd.VK_TEXT", zztext);
	Class'UIAPI_TEXTBOX'.static.SetTextColor("EulaClassicWnd.VK_TEXT", xxGetColorito("White"));
	return;
}
