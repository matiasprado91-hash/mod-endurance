function OnTabSplit(string sTabButton)
{
	local ChatWindowHandle BtnAllBlock;

	switch(sTabButton)
	{
		// End:0x31
		case "ChatTabCtrl0":
			BtnAllBlock = NormalChat;
			HandleTabClick(sTabButton);
				// End:0xDF
			break;
		// End:0x5B
		case "ChatTabCtrl1":
			BtnAllBlock = TradeChat;
			HandleTabClick(sTabButton);
				// End:0xDF
			break;
		// End:0x85
		case "ChatTabCtrl2":
			BtnAllBlock = PartyChat;
			HandleTabClick(sTabButton);
				// End:0xDF
			break;
		// End:0xAF
		case "ChatTabCtrl3":
			BtnAllBlock = ClanChat;
			HandleTabClick(sTabButton);
				// End:0xDF
			break;
		// End:0xD9
		case "ChatTabCtrl4":
			BtnAllBlock = AllyChat;
			HandleTabClick(sTabButton);
				// End:0xDF
			break;
		// End:0xFFFF
		default:
				// End:0xDF
			break;
			break;
	}
// End:0x125
	if( BtnAllBlock != None )
	{
		BtnAllBlock.SetWindowSizeRel(-1, -1, 0, 0);
		BtnAllBlock.SetSettledWnd(True);
		BtnAllBlock.EnableTexture(True);
	}
	return;
}

function OnTabMerge(string sTabButton)
{
	local ChatWindowHandle BtnAllBlock;
	local int Width, Height;
	local Rect rectWnd;

	switch(sTabButton)
	{
		// End:0x26
		case "ChatTabCtrl0":
			BtnAllBlock = NormalChat;
				// End:0xA8
			break;
		// End:0x45
		case "ChatTabCtrl1":
			BtnAllBlock = TradeChat;
				// End:0xA8
			break;
		// End:0x64
		case "ChatTabCtrl2":
			BtnAllBlock = PartyChat;
				// End:0xA8
			break;
		// End:0x83
		case "ChatTabCtrl3":
			BtnAllBlock = ClanChat;
				// End:0xA8
			break;
		// End:0xA2
		case "ChatTabCtrl4":
			BtnAllBlock = AllyChat;
				// End:0xA8
			break;
		// End:0xFFFF
		default:
				// End:0xA8
			break;
			break;
	}
// End:0x160
	if( BtnAllBlock != None )
	{
		rectWnd = NormalChat.GetRect();
		NormalChat.GetWindowSize(Width, Height);
		BtnAllBlock.SetSettledWnd(False);
		BtnAllBlock.MoveTo(rectWnd.nX, rectWnd.nY);
		BtnAllBlock.SetWindowSize(Width, Height - 46);
		BtnAllBlock.SetWindowSizeRel(1, 1, 0, -46);
		BtnAllBlock.EnableTexture(False);
	}
	return;
}

function HandleTabClick(string zzparam)
{
	local string zzweaaa, strPrefix;
	local int StrLen;

	m_chatType = ChatTabCtrl.GetTopIndex();
	SetChatFilterButton();
// End:0x10D
	if( GetOptionBool("Game", "OldChatting") == True )
	{
		zzweaaa = ChatEditBox.GetString();
		StrLen = Len(zzweaaa);
		strPrefix = Left(zzweaaa, 1);
		// End:0xC5
		if( (((IsSameChatPrefix(EChatType(8), strPrefix)) || IsSameChatPrefix(EChatType(3), strPrefix)) || IsSameChatPrefix(EChatType(4), strPrefix)) || IsSameChatPrefix(EChatType(9), strPrefix) )
		{
			zzweaaa = Right(zzweaaa, StrLen - 1);
		}
		// End:0xF9
		if( m_chatType != 0 )
		{
			strPrefix = GetChatPrefix(GetChatTypeByTabIndex(m_chatType));
			zzweaaa = strPrefix$zzweaaa;
		}
		ChatEditBox.SetString(zzweaaa);
	}
	return;
}

function OnEnterState(name a_PrevStateName)
{
// End:0x15
	if( a_PrevStateName == 'LoadingState' )
	{
		Clear();
	}
	return;
}

function OnEvent(int Event_ID, string param)
{
	switch(Event_ID)
	{
		// End:0x1D
		case 540:
			HandleChatmessage(param);
				// End:0xA6
			break;
		// End:0x2E
		case 1500:
			HandleIMEStatusChange();
				// End:0xA6
			break;
		// End:0x3F
		case 550:
			HandleChatWndStatusChange();
				// End:0xA6
			break;
		// End:0x50
		case 570:
			HandleSetFocus();
				// End:0xA6
			break;
		// End:0x66
		case 560:
			HandleSetString(param);
				// End:0xA6
			break;
		// End:0x7C
		case 571:
			HandleMsnStatus(param);
				// End:0xA6
			break;
		// End:0x92
		case 572:
			HandleChatWndMacroCommand(param);
				// End:0xA6
			break;
		// End:0xA0
		case 150:
			xxhideshowchat();
				// End:0xA6
			break;
		// End:0xFFFF
		default:
				// End:0xA6
			break;
			break;
	}
	return;
}

function HandleChatWndMacroCommand(string param)
{
	local string Command;

// End:0x20
	if( !ParseString(param, "Command", Command) )
	{
		return;
	}
	ProcessChatMessage(Command, m_chatType);
	return;
}

function HandleChatmessage(string param)
{
	local int nTmp;
	local EChatType zzchattype;
	local ESystemMsgType systemType;
	local string text, zzdeeaa;
	local Color Color;
	local WhispAlertWnd PartyMatchWnd;

	PartyMatchWnd = WhispAlertWnd(GetScript("WhispAlertWnd"));
	ParseInt(param, "Type", nTmp);
	zzchattype = EChatType(nTmp);
	ParseString(param, "Msg", text);
	ParseInt(param, "ColorR", nTmp);
	Color.R = byte(nTmp);
	ParseInt(param, "ColorG", nTmp);
	Color.G = byte(nTmp);
	ParseInt(param, "ColorB", nTmp);
	Color.B = byte(nTmp);
	Color.A = byte(255);
// End:0x11E
	if( zzchattype == 5 )
	{
		ParseInt(param, "SysType", nTmp);
		systemType = ESystemMsgType(nTmp);        
	}
	else
	{
		systemType = ESystemMsgType(0);
	}
// End:0x151
	if( zzwewtta == 0 )
	{
		ChatWnd.SetTimer(30000, 10000);
		zzwewtta++;
	}
// End:0x173
	if( zzchattype == 18 )
	{
		// End:0x173
		if( zzwasa == 0 )
		{
			zzwasa++;
		}
	}
	zzdeeaa = "Welcome to the Best!";
// End:0x1E0
	if( zzasdwa2a == 0 )
	{
		// End:0x1E0
		if( zzchattype == 18 )
		{
				// End:0x1C6
			if( Right(text, 20) != zzdeeaa )
			{
		//        RequestExit();                
			}
			else
			{
						// End:0x1E0
				if( Right(text, 20) == zzdeeaa )
				{
					zzasdwa2a++;
				}
			}
		}
	}
	switch(zzchattype)
	{
		// End:0x1FA
		case EChatType(10):
			xxnotifyserverespecial(text);
				// End:0x210
			break;
		// End:0x20D
		case EChatType(18):
			xxnotifyserverespecial(text);
				// End:0x210
			break;
		// End:0xFFFF
		default:
			break;
	}
// End:0x259
	if( Left(text, 3) == "___" )
	{
		// End:0x256
		if( text == "___EV_ShowInventory" )
		{
			ShowWindow("InventoryWnd");
		}        
	}
	else
	{
		// End:0x286
		if( CheckFilter(zzchattype, 0, systemType) )
		{
			NormalChat.AddString(text, Color);
		}
		// End:0x2B4
		if( CheckFilter(zzchattype, 2, systemType) )
		{
			PartyChat.AddString(text, Color);
		}
		// End:0x2E2
		if( CheckFilter(zzchattype, 3, systemType) )
		{
			ClanChat.AddString(text, Color);
		}
		// End:0x30F
		if( CheckFilter(zzchattype, 1, systemType) )
		{
			TradeChat.AddString(text, Color);
		}
		// End:0x33D
		if( CheckFilter(zzchattype, 4, systemType) )
		{
			AllyChat.AddString(text, Color);
		}
		// End:0x36B
		if( CheckFilter(zzchattype, 5, systemType) )
		{
			SystemMsg.AddString(text, Color);
		}
		// End:0x3AC
		if( (zzchattype == 15) && m_NoUnionCommanderMessage == 0 )
		{
			NormalChat.AddString(text, Color);
			ShowUnionCommanderMessgage(text);
		}
		// End:0x3D0
		if( zzchattype == 2 )
		{
			PartyMatchWnd.WhispMessage(param);
		}
	}
	return;
}

function ShowUnionCommanderMessgage(string Msg)
{
	local string strParam, MsgTemp, MsgTemp2;
	local int maxLength;

	maxLength = Len(Msg);
// End:0x55
	if( maxLength > 35 )
	{
		MsgTemp = Left(Msg, 35);
		MsgTemp2 = Right(Msg, maxLength - 35);
		Msg = (MsgTemp$"#")$MsgTemp2;
	}
	Debug(Msg);
// End:0x17E
	if( Len(Msg) > 0 )
	{
		ParamAdd(strParam, "MsgType", string(1));
		ParamAdd(strParam, "WindowType", string(8));
		ParamAdd(strParam, "FontType", string(0));
		ParamAdd(strParam, "BackgroundType", string(0));
		ParamAdd(strParam, "LifeTime", string(5000));
		ParamAdd(strParam, "AnimationType", string(1));
		ParamAdd(strParam, "Msg", Msg);
		ParamAdd(strParam, "MsgColorR", string(255));
		ParamAdd(strParam, "MsgColorG", string(150));
		ParamAdd(strParam, "MsgColorB", string(149));
		ExecuteEvent(140, strParam);
	}
	return;
}

