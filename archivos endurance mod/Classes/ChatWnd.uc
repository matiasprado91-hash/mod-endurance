function OnLoad()
{
	m_filterInfo.Length = 5 + 1;
	RegisterEvent(540);
	RegisterEvent(1500);
	RegisterEvent(550);
	RegisterEvent(560);
	RegisterEvent(570);
	RegisterEvent(571);
	RegisterEvent(572);
	RegisterEvent(150);
	m_sectionName.Length = 5;
	m_sectionName[0] = "entire_tab";
	m_sectionName[1] = "pledge_tab";
	m_sectionName[2] = "party_tab";
	m_sectionName[3] = "market_tab";
	m_sectionName[4] = "ally_tab";
	RegisterState("ChatWnd", "OlympiadObserverState");
	btnfilter = ButtonHandle(GetHandle("ChatHideWnd.ChatFilterBtn"));
	btnfilter.SetTooltipCustomType(infotooltip("Filtro del Chat"));
	ChatWnd = xxGetWindowHandle("ChatWnd");
	InitHandle();
	InitFilterInfo();
	InitGlobalSetting();
	InitScrollBarPosition();
	zzasdwa2a = 0;
	zzwasa = 0;
	zzwewtta = 0;
	return;
}

function OnDefaultPosition()
{
	ChatTabCtrl.MergeTab(1);
	ChatTabCtrl.MergeTab(2);
	ChatTabCtrl.MergeTab(3);
	ChatTabCtrl.MergeTab(4);
	ChatTabCtrl.SetTopOrder(0, True);
	Class'UIAPI_WINDOW'.static.SetAnchor("ChatWnd", "", "BottomLeft", "BottomLeft", 0, -28);
	HandleTabClick("ChatTabCtrl0");
	return;
}

function xxhideshowchat()
{
// End:0x48
	if( GetOptionBool("Lotus_Custom", "ChatHide") == False )
	{
		ShowWindow("ChatHideWnd");
		HideWindow("ChatWnd");
	}
	return;
}

function InitGlobalSetting()
{
	Class'UIAPI_CHECKBOX'.static.SetCheck("ChatFilterWnd.CheckBoxCommand", bool(m_NoUnionCommanderMessage));
	return;
}

function InitHandle()
{
	NormalChat = ChatWindowHandle(GetHandle("ChatWnd.NormalChat"));
	TradeChat = ChatWindowHandle(GetHandle("ChatWnd.TradeChat"));
	PartyChat = ChatWindowHandle(GetHandle("ChatWnd.PartyChat"));
	ClanChat = ChatWindowHandle(GetHandle("ChatWnd.ClanChat"));
	AllyChat = ChatWindowHandle(GetHandle("ChatWnd.AllyChat"));
	SystemMsg = ChatWindowHandle(GetHandle("SystemMsgWnd.SystemMsgList"));
	ChatTabCtrl = TabHandle(GetHandle("ChatWnd.ChatTabCtrl"));
	ChatEditBox = EditBoxHandle(GetHandle("ChatWnd.ChatEditBox"));
	btnhide = xxGetButtonHandle("ChatWnd.btnHideChat");
	btnhide.SetTooltipCustomType(infotooltip("Hide Chat Window"));
	return;
}

function InitScrollBarPosition()
{
	NormalChat.SetScrollBarPosition(5, 10, 4);
	TradeChat.SetScrollBarPosition(5, 10, 4);
	PartyChat.SetScrollBarPosition(5, 10, 4);
	ClanChat.SetScrollBarPosition(5, 10, 4);
	AllyChat.SetScrollBarPosition(5, 10, 4);
	return;
}

function OnCompleteEditBox(string zzparam)
{
	local string zzweaaa;
	local EChatType zzchattype;

// End:0xE1
	if( zzparam == "ChatEditBox" )
	{
		zzweaaa = ChatEditBox.GetString();
		// End:0x3B
		if( Len(zzweaaa) < 1 )
		{
			return;
		}
		ProcessChatMessage(zzweaaa, m_chatType);
		ChatEditBox.SetString("");
		// End:0xB1
		if( GetOptionBool("Game", "OldChatting") == True )
		{
			zzchattype = GetChatTypeByTabIndex(m_chatType);
				// End:0xB1
			if( m_chatType != 0 )
			{
				ChatEditBox.AddString(GetChatPrefix(zzchattype));
			}
		}
		// End:0xE1
		if( GetOptionBool("Game", "EnterChatting") == True )
		{
			ChatEditBox.ReleaseFocus();
		}
	}
	return;
}

function Clear()
{
	ChatEditBox.Clear();
	NormalChat.Clear();
	PartyChat.Clear();
	ClanChat.Clear();
	TradeChat.Clear();
	AllyChat.Clear();
	SystemMsg.Clear();
	return;
}

